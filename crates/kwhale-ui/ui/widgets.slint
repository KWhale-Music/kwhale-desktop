import { Theme } from "tokens.slint";
import { Icon } from "icons.slint";
import { ArtistItem, ShelfItem, TrackItem } from "models.slint";

export component NavButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> rail-mode: false;
    callback clicked();

    height: 40px;
    border-radius: Theme.nav-radius;
    background: root.active ? Theme.primary-container : (ta.pressed ? Theme.surface-high : (ta.has-hover ? Theme.surface-container : transparent));
    border-width: (root.active && !Theme.is-gnome) ? 1px : 0px;
    border-color: Theme.outline-variant;

    animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    HorizontalLayout {
        padding-left: root.rail-mode ? 0px : 12px;
        padding-right: root.rail-mode ? 0px : 12px;
        spacing: 12px;
        alignment: root.rail-mode ? center : start;

        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon-name;
                icon-size: 19px;
                icon-color: root.active ? Theme.on-primary-container : Theme.on-surface-variant;
            }
        }

        if !root.rail-mode: Text {
            text: root.label;
            font-family: Theme.text-font;
            font-size: 13.5px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.on-primary-container : Theme.on-surface-variant;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AlbumCard inherits Rectangle {
    in property <ShelfItem> item;
    callback activated();

    min-width: 0px;
    preferred-width: 0px;
    background: transparent;

    VerticalLayout {
        width: 100%;
        padding: 0px;
        spacing: 8px;

        Rectangle {
            width: 100%;
            height: self.width;
            preferred-height: self.width;
            border-radius: Theme.card-radius;
            background: Theme.surface-container;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                preferred-width: 0px;
                preferred-height: 0px;
                source: root.item.cover;
                image-fit: cover;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: ta.pressed ? Theme.on-surface.with-alpha(0.14) : (ta.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent);
                animate background { duration: 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            }

            Rectangle {
                x: parent.width - 44px;
                y: parent.height - 44px;
                width: 36px;
                height: 36px;
                border-radius: Theme.is-gnome ? 18px : 8px;
                background: ta.pressed ? Theme.primary-pressed : (ta.has-hover ? Theme.primary-hover : Theme.primary);
                opacity: ta.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }

                Icon {
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    name: "play";
                    icon-size: 18px;
                    icon-color: Theme.on-primary;
                }
            }
        }

        VerticalLayout {
            width: 100%;
            spacing: 2px;
            Text {
                width: 100%;
                preferred-width: 0px;
                text: root.item.title;
                font-family: Theme.text-font;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.on-surface;
                overflow: elide;
            }
            Text {
                width: 100%;
                preferred-width: 0px;
                text: root.item.subtitle;
                font-family: Theme.text-font;
                font-size: 11.5px;
                font-weight: 400;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component ArtistCard inherits Rectangle {
    in property <ArtistItem> item;
    callback activated();

    min-width: 0px;
    preferred-width: 0px;
    background: transparent;

    VerticalLayout {
        width: 100%;
        padding: 0px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 112px;
                height: 112px;
                border-radius: 56px;
                background: Theme.surface-container;
                clip: true;
                Image {
                    width: 100%;
                    height: 100%;
                    preferred-width: 0px;
                    preferred-height: 0px;
                    source: root.item.cover;
                    image-fit: cover;
                }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 56px;
                    background: ta.pressed ? Theme.on-surface.with-alpha(0.14) : (ta.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent);
                    animate background { duration: 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                }
            }
        }

        Text {
            width: 100%;
            preferred-width: 0px;
            text: root.item.name;
            font-size: 13.5px;
            font-weight: 600;
            color: Theme.on-surface;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.item.followers-text != "": Text {
            width: 100%;
            preferred-width: 0px;
            text: root.item.followers-text;
            font-size: 11.5px;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component TransportIconButton inherits Rectangle {
    in property <string> icon-name;
    in property <bool> active: false;
    in property <bool> on-dark-overlay: false;
    in property <length> icon-size: 20px;
    in property <length> btn-size: 36px;
    callback clicked();

    width: btn-size;
    height: btn-size;
    border-radius: Theme.is-gnome ? (btn-size / 2) : 6px;
    background: ta.pressed ? (root.on-dark-overlay ? Theme.overlay-surface-pressed : Theme.surface-highest) : (ta.has-hover ? (root.on-dark-overlay ? Theme.overlay-surface-hover : Theme.surface-high) : transparent);
    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon-name;
        icon-size: root.icon-size;
        icon-color: root.active ? (root.on-dark-overlay ? Theme.overlay-accent : Theme.primary) : (root.on-dark-overlay ? Theme.overlay-fg-muted : Theme.on-surface-variant);
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueueRow inherits Rectangle {
    in property <TrackItem> item;
    callback clicked();
    callback remove-clicked();

    height: 56px;
    border-radius: Theme.row-radius;
    background: root.item.active ? Theme.primary-container : (ta.pressed ? Theme.surface-high : (ta.has-hover ? Theme.surface-container : transparent));

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: Theme.surface-high;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.cover;
                    image-fit: cover;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.title;
                font-family: Theme.text-font;
                font-size: 13px;
                font-weight: root.item.active ? 600 : 500;
                color: root.item.active ? Theme.on-primary-container : Theme.on-surface;
                overflow: elide;
            }
            Text {
                text: root.item.artist;
                font-family: Theme.text-font;
                font-size: 11.5px;
                color: root.item.active ? Theme.on-primary-container : Theme.on-surface-variant;
                opacity: root.item.active ? 0.85 : 1.0;
                overflow: elide;
            }
        }

        if root.item.active: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                height: 14px;
                alignment: center;
                Rectangle { width: 3px; height: 9px; border-radius: 1.5px; background: Theme.on-primary-container; y: 5px; }
                Rectangle { width: 3px; height: 14px; border-radius: 1.5px; background: Theme.on-primary-container; y: 0px; }
                Rectangle { width: 3px; height: 7px; border-radius: 1.5px; background: Theme.on-primary-container; y: 7px; }
            }
        }

        if !root.item.active: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: rm-ta.pressed ? Theme.surface-highest : (rm-ta.has-hover ? Theme.surface-high : transparent);
                opacity: (ta.has-hover || rm-ta.has-hover || rm-ta.pressed) ? 1.0 : 0.36;
                animate opacity { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                animate background { duration: 120ms; }
                Icon {
                    x: 5px;
                    y: 5px;
                    name: "close";
                    icon-size: 14px;
                    icon-color: rm-ta.has-hover ? Theme.on-surface : Theme.on-surface-variant;
                }
                rm-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove-clicked(); }
                }
            }
        }
    }
}

export component TrackRow inherits Rectangle {
    in property <int> index;
    in property <TrackItem> item;
    callback play();
    callback toggle-like();
    callback open-menu();

    height: 56px;
    border-radius: Theme.row-radius;
    background: root.item.active ? Theme.primary-container : (ta.pressed ? Theme.surface-high : (ta.has-hover ? Theme.surface-container : transparent));

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            width: 32px;
            alignment: center;
            if root.item.active: HorizontalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle { width: 3px; height: 8px; border-radius: 1.5px; background: Theme.on-primary-container; y: 5px; }
                Rectangle { width: 3px; height: 13px; border-radius: 1.5px; background: Theme.on-primary-container; }
                Rectangle { width: 3px; height: 10px; border-radius: 1.5px; background: Theme.on-primary-container; y: 3px; }
            }
            if !root.item.active: Text {
                text: root.index + 1;
                font-family: Theme.text-font;
                font-size: 13px;
                color: Theme.on-surface-variant;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: Theme.surface-high;
                clip: true;
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.cover;
                    image-fit: cover;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.title;
                    font-family: Theme.text-font;
                    font-size: 14px;
                    font-weight: 600;
                    color: root.item.active ? Theme.on-primary-container : Theme.on-surface;
                    overflow: elide;
                }
                if root.item.explicit: Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.surface-highest;
                    Text {
                        text: "E";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.item.downloaded: VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "check";
                        icon-size: 14px;
                        icon-color: root.item.active ? Theme.on-primary-container : Theme.primary;
                    }
                }
            }

            Text {
                text: root.item.album != "" ? (root.item.artist + " · " + root.item.album) : root.item.artist;
                font-family: Theme.text-font;
                font-size: 12px;
                color: root.item.active ? Theme.on-primary-container : Theme.on-surface-variant;
                opacity: root.item.active ? 0.85 : 1.0;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: like-ta.pressed ? Theme.surface-highest : (like-ta.has-hover ? Theme.surface-high : transparent);
                animate background { duration: 120ms; }
                Icon {
                    x: 7px;
                    y: 7px;
                    name: root.item.liked ? "heart-fill" : "heart";
                    icon-size: 18px;
                    icon-color: root.item.liked ? (root.item.active ? Theme.on-primary-container : Theme.primary) : (root.item.active ? Theme.on-primary-container : Theme.on-surface-variant);
                }
                like-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-like(); }
                }
            }
        }

        Text {
            text: root.item.duration;
            font-family: Theme.text-font;
            font-size: 12.5px;
            color: root.item.active ? Theme.on-primary-container : Theme.on-surface-variant;
            width: 44px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: menu-ta.pressed ? Theme.surface-highest : (menu-ta.has-hover ? Theme.surface-high : transparent);
                animate background { duration: 120ms; }
                Icon {
                    x: 7px;
                    y: 7px;
                    name: "more";
                    icon-size: 18px;
                    icon-color: root.item.active ? Theme.on-primary-container : Theme.on-surface-variant;
                }
                menu-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-menu(); }
                }
            }
        }
    }
}
