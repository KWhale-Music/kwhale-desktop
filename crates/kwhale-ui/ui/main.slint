import { ScrollView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { Icon, WhaleLogo } from "icons.slint";
import {
    ShelfItem, ArtistItem, MixChipItem, TrackItem, SidebarPlaylistItem,
    AccentOption, LyricLineItem, DownloadItem, GenreChip, TrackMenuInfo
} from "models.slint";
import {
    NavButton, AlbumCard, ArtistCard, TransportIconButton, QueueRow, TrackRow
} from "widgets.slint";
import { PlayerWidgetWindow } from "player_widget.slint";

export {
    Theme, ShelfItem, ArtistItem, MixChipItem, TrackItem, SidebarPlaylistItem,
    AccentOption, LyricLineItem, DownloadItem, GenreChip, TrackMenuInfo, PlayerWidgetWindow
}

export component MainWindow inherits Window {
    title: "KWhale";
    preferred-width: 1320px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 580px;
    background: Theme.surface;
    default-font-family: Theme.text-font;

    // Debug scroll properties for automated testing
    out property <length> debug-main-viewport-height: main-scroll.content-height;
    out property <length> debug-main-visible-height: main-scroll.visible-height;
    out property <length> debug-main-viewport-y <=> main-scroll.content-y;
    out property <length> debug-queue-viewport-height: queue-scroll.content-height;
    out property <length> debug-queue-visible-height: queue-scroll.visible-height;
    out property <length> debug-queue-viewport-y <=> queue-scroll.content-y;

    // App mode & Auth
    in-out property <bool> demo-mode: false;
    in-out property <bool> authenticated: false;
    in-out property <bool> auth-register-mode: false;
    in-out property <bool> auth-loading: false;
    in-out property <string> auth-server-url: "https://music.dueattendant149.org/v1";
    in-out property <bool> auth-allow-http: false;
    in-out property <string> auth-email: "";
    in-out property <string> auth-password: "";
    in-out property <string> auth-display-name: "";
    in-out property <string> auth-invite: "";
    in-out property <string> auth-error: "";
    in-out property <string> server-check-status: "";

    // Navigation & Layout
    in-out property <string> active-nav: "home";
    in-out property <bool> queue-open: true;
    in-out property <string> right-tab: "queue"; // "queue" | "lyrics"
    in-out property <bool> player-open: false;

    // Theme & User Identity
    in-out property <string> theme-mode: "dark";
    in-out property <bool> follow-system-accent: false;
    in-out property <string> platform-setting: "auto";
    in-out property <bool> close-to-tray: true;
    in property <string> user-initials: "";
    in property <string> user-name: "";
    in property <string> user-email: "";
    in property <image> user-avatar;
    in property <bool> user-has-avatar: false;
    in property <string> profile-stats-text: "";
    in property <string> server-url: "";
    in property <string> toast-message: "";

    // AI / Prompt settings
    in-out property <string> llm-endpoint-input: "";
    in-out property <string> llm-model-input: "";
    in-out property <string> llm-key-input: "";

    // Home state
    in property <bool> home-loading: false;
    in property <string> home-error: "";
    in property <string> greeting: "Добрый вечер";
    in property <string> hero-badge: "Продолжить слушать";
    in property <string> hero-title: "";
    in property <string> hero-artist: "";
    in property <string> hero-time: "";
    in property <float> hero-progress: 0.0;
    in-out property <int> hero-slide: 0;
    in property <int> hero-slide-count: 3;
    in property <image> hero-backdrop;
    in property <image> hero-cover;
    in property <bool> has-hero-cover: false;
    in-out property <string> prompt-text: "";
    in property <bool> prompt-loading: false;
    in property <[MixChipItem]> mix-chips;
    in property <string> recent-section-title: "Для тебя и открытия";
    in property <string> chart-section-title: "Недавно добавленные альбомы";
    in property <string> tracks-section-title: "Недавно прослушанное";
    in property <bool> recent-has-shift: false;
    in property <bool> chart-has-shift: false;
    in property <[ShelfItem]> recent-releases;
    in property <[ShelfItem]> chart-items;
    in property <[TrackItem]> tracks;

    // Search state
    in-out property <string> search-query: "";
    in-out property <string> search-filter: "all";
    in property <bool> search-loading: false;
    in property <bool> search-refining: false;
    in property <string> search-error: "";
    in property <[string]> search-history;
    in property <[string]> search-suggestions;
    in property <[GenreChip]> search-genres;
    in property <[ArtistItem]> search-artists;
    in property <[ShelfItem]> search-shelves;
    in property <[TrackItem]> search-tracks;

    // Library & Sidebar Playlists state
    in-out property <string> library-tab: "collections"; // "collections" | "playlists" | "albums" | "tracks"
    in-out property <string> library-sort: "default"; // "default" | "added" | "title" | "artist"
    in-out property <string> library-filter-query: "";
    in property <bool> library-loading: false;
    in property <bool> library-has-more: false;
    in property <string> liked-count-text: "0 треков";
    in property <[SidebarPlaylistItem]> sidebar-playlists;
    in property <[ShelfItem]> library-collections;
    in property <[ShelfItem]> library-collections-row2;
    in property <[TrackItem]> library-tracks;

    // History & Downloads
    in property <bool> history-loading: false;
    in property <bool> history-has-more: false;
    in property <[TrackItem]> history-tracks;
    in property <[DownloadItem]> download-items;

    // Collection & Artist detail state
    in property <string> collection-kind: "album"; // "album" | "playlist" | "artist" | "favorites"
    in property <string> collection-id: "";
    in property <string> collection-title: "";
    in property <string> collection-subtitle: "";
    in property <string> collection-meta: "";
    in property <string> collection-artist-id: "";
    in property <string> collection-sync-text: "";
    in property <image> collection-cover;
    in property <bool> collection-loading: false;
    in property <bool> collection-saved: false;
    in property <bool> collection-can-edit: false;
    in property <[TrackItem]> collection-tracks;
    in property <[ShelfItem]> collection-albums;
    in property <[ShelfItem]> collection-singles;

    // Modals (Track menu & Playlist Create/Edit)
    in-out property <TrackMenuInfo> track-menu;
    in-out property <bool> playlist-modal-open: false;
    in-out property <bool> playlist-modal-edit: false;
    in-out property <string> playlist-modal-title: "";
    in-out property <string> playlist-modal-desc: "";
    in-out property <bool> playlist-modal-public: false;

    // Queue, Lyrics & Player state
    in property <[TrackItem]> queue-items;
    in property <[LyricLineItem]> lyric-lines;
    in property <[AccentOption]> accent-swatches;
    in property <bool> has-current-track: false;
    in property <bool> playing: false;
    in property <string> now-title: "";
    in property <string> now-artist: "";
    in property <string> now-pos-text: "0:00";
    in property <string> now-dur-text: "0:00";
    in property <image> now-cover;
    in property <image> now-cover-hd;
    in property <image> player-backdrop;
    in property <bool> now-liked: false;
    in property <float> progress: 0.0;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0;
    in property <float> volume: 0.72;
    in property <bool> muted: false;

    // Callbacks
    callback nav(string);
    callback navigate-back();
    callback check-server(string, bool);
    callback submit-login(string, bool, string, string);
    callback submit-register(string, bool, string, string, string, string);
    callback logout();

    callback refresh-home();
    callback cycle-hero-slide(int);
    callback play-hero();
    callback start-wave();
    callback submit-prompt-mix(string);
    callback play-mix(string);
    callback shift-shelf(string, int);

    callback search-query-edited(string);
    callback search-submitted(string, string);
    callback select-search-filter(string);
    callback apply-search-chip(string);
    callback clear-search-history();
    callback open-artist(string);

    callback select-library-tab(string);
    callback select-library-sort(string);
    callback library-filter-changed(string);
    callback load-more-library();
    callback shuffle-library();
    callback open-favorites();
    callback open-create-playlist();
    callback submit-playlist-modal(string, string, bool);

    callback load-more-history();
    callback clear-history();
    callback play-history-track(int);

    callback play-all-downloads();
    callback clear-all-downloads();
    callback remove-download(string);
    callback retry-download(string);
    callback play-download-track(int);

    callback open-shelf-item(string, string);
    callback play-collection();
    callback shuffle-collection();
    callback toggle-save-collection();
    callback download-all-collection();
    callback open-rename-collection();
    callback delete-collection();
    callback play-collection-track(int);

    callback play-track(string, int); // source ("home"|"search"|"library"|"history"|"collection"), index
    callback toggle-like-track(string, int);
    callback open-track-menu(string, int);
    callback close-track-menu();
    callback track-menu-play-next();
    callback track-menu-add-queue();
    callback track-menu-toggle-like();
    callback track-menu-toggle-dislike();
    callback track-menu-toggle-download();
    callback track-menu-open-album();
    callback track-menu-open-artist();
    callback track-menu-share();
    callback track-menu-load-info();
    callback track-menu-report-censorship();
    callback track-menu-add-to-playlist(string);
    callback track-menu-remove-from-playlist();

    callback jump-queue(int);
    callback remove-queue-item(int);
    callback clear-queue();
    callback seek-lyric(int);
    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-like-current();
    callback seek-to(float);
    callback set-volume(float);
    callback toggle-mute();

    callback set-platform(string);
    callback set-theme-mode(string);
    callback set-follow-system-accent(bool);
    callback select-accent(int);
    callback save-ai-settings(string, string, string);
    callback set-close-to-tray(bool);
    callback open-widget();
    callback hide-to-tray();

    property <bool> rail-mode: root.width < 980px;
    property <bool> show-app: root.authenticated || root.demo-mode;

    // ==================== AUTH GATE (WHEN LOGGED OUT) ====================
    if !root.show-app: auth-scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        content-width: self.visible-width;
        content-height: max(self.visible-height, auth-box.preferred-height);

        auth-box := VerticalLayout {
            width: parent.visible-width;
            alignment: center;
            padding-top: 32px;
            padding-bottom: 32px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: min(460px, root.width - 48px);
                    border-radius: Theme.hero-radius;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 14px;
                        alignment: start;

                        // Brand header
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            WhaleLogo {
                                icon-size: 36px;
                                icon-color: Theme.primary;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "KWhale";
                                    font-family: Theme.display-font;
                                    font-size: 24px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Музыка для себя";
                                    font-size: 12.5px;
                                    color: Theme.on-surface-variant;
                                }
                            }
                        }

                        Rectangle { height: 4px; }

                        // Server Connection Section (flat layout, no card-in-card border box)
                        VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Сервер KWhale";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 28px;
                                    border-radius: Theme.pill-radius;
                                    background: chk-ta.pressed ? Theme.surface-highest : (chk-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: "Проверить";
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: chk-ta.has-hover ? Theme.on-primary-container : Theme.primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chk-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.check-server(root.auth-server-url, root.auth-allow-http); }
                                    }
                                }
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: Theme.row-radius;
                                background: Theme.surface-high;
                                border-width: 1px;
                                border-color: srv-inp.has-focus ? Theme.primary : Theme.outline-variant;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    srv-inp := TextInput {
                                        width: 100%;
                                        text <=> root.auth-server-url;
                                        font-size: 13px;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                for preset in [
                                    { label: "dueattendant149", url: "https://music.dueattendant149.org/v1", http: false },
                                    { label: "localhost", url: "http://127.0.0.1:19001/v1", http: true },
                                ]: Rectangle {
                                    property <bool> is-sel: root.auth-server-url == preset.url;
                                    height: 28px;
                                    border-radius: Theme.pill-radius;
                                    background: is-sel ? Theme.primary-container : (pre-ta.pressed ? Theme.surface-highest : (pre-ta.has-hover ? Theme.surface-highest : Theme.surface-high));
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: preset.label;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: is-sel ? Theme.on-primary-container : Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    pre-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.auth-server-url = preset.url;
                                            root.auth-allow-http = preset.http;
                                            root.server-check-status = "";
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Rectangle {
                                    height: 28px;
                                    border-radius: Theme.row-radius;
                                    background: http-ta.pressed ? Theme.surface-highest : (http-ta.has-hover ? Theme.surface-high : transparent);
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 4px;
                                                background: root.auth-allow-http ? Theme.primary : Theme.surface-high;
                                                border-width: 1px;
                                                border-color: root.auth-allow-http ? Theme.primary : Theme.outline;
                                                if root.auth-allow-http: Icon {
                                                    x: 2px;
                                                    y: 2px;
                                                    name: "check";
                                                    icon-size: 12px;
                                                    icon-color: Theme.on-primary;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "HTTP";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    http-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.auth-allow-http = !root.auth-allow-http; }
                                    }
                                }
                            }

                            if root.server-check-status != "": Text {
                                text: root.server-check-status;
                                font-size: 12px;
                                color: Theme.primary;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.outline-variant;
                            opacity: 0.65;
                        }

                        // Login / Register Segmented Track
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.pill-radius;
                            background: Theme.surface-low;
                            HorizontalLayout {
                                padding: 4px;
                                spacing: 4px;
                                for mode in [
                                    { reg: false, label: "Вход" },
                                    { reg: true, label: "Регистрация" },
                                ]: Rectangle {
                                    property <bool> is-sel: root.auth-register-mode == mode.reg;
                                    horizontal-stretch: 1;
                                    border-radius: max(4px, Theme.pill-radius - 2px);
                                    background: is-sel ? Theme.primary-container : (mode-ta.pressed ? Theme.surface-highest : (mode-ta.has-hover ? Theme.surface-high : transparent));
                                    animate background { duration: 120ms; }
                                    Text {
                                        text: mode.label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: is-sel ? Theme.on-primary-container : Theme.on-surface-variant;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    mode-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.auth-register-mode = mode.reg;
                                            root.auth-error = "";
                                        }
                                    }
                                }
                            }
                        }

                        if root.auth-register-mode: Rectangle {
                            height: 42px;
                            border-radius: Theme.row-radius;
                            background: Theme.surface-high;
                            border-width: 1px;
                            border-color: reg-name-inp.has-focus ? Theme.primary : Theme.outline-variant;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    if root.auth-display-name == "" && !reg-name-inp.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: "Отображаемое имя";
                                        font-size: 13px;
                                        color: Theme.on-surface-variant;
                                        vertical-alignment: center;
                                    }
                                    reg-name-inp := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.auth-display-name;
                                        font-size: 13px;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                        }

                        if root.auth-register-mode: Rectangle {
                            height: 42px;
                            border-radius: Theme.row-radius;
                            background: Theme.surface-high;
                            border-width: 1px;
                            border-color: reg-inv-inp.has-focus ? Theme.primary : Theme.outline-variant;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    if root.auth-invite == "" && !reg-inv-inp.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: "Токен приглашения (invite)";
                                        font-size: 13px;
                                        color: Theme.on-surface-variant;
                                        vertical-alignment: center;
                                    }
                                    reg-inv-inp := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.auth-invite;
                                        font-size: 13px;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                        }

                        // Email
                        Rectangle {
                            height: 42px;
                            border-radius: Theme.row-radius;
                            background: Theme.surface-high;
                            border-width: 1px;
                            border-color: email-inp.has-focus ? Theme.primary : Theme.outline-variant;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    if root.auth-email == "" && !email-inp.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: "Email";
                                        font-size: 13px;
                                        color: Theme.on-surface-variant;
                                        vertical-alignment: center;
                                    }
                                    email-inp := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.auth-email;
                                        font-size: 13px;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                        }

                        // Password
                        Rectangle {
                            height: 42px;
                            border-radius: Theme.row-radius;
                            background: Theme.surface-high;
                            border-width: 1px;
                            border-color: pass-inp.has-focus ? Theme.primary : Theme.outline-variant;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    if root.auth-password == "" && !pass-inp.has-focus: Text {
                                        width: 100%; height: 100%;
                                        text: root.auth-register-mode ? "Пароль (минимум 8 символов)" : "Пароль";
                                        font-size: 13px;
                                        color: Theme.on-surface-variant;
                                        vertical-alignment: center;
                                    }
                                    pass-inp := TextInput {
                                        width: 100%; height: 100%;
                                        text <=> root.auth-password;
                                        input-type: InputType.password;
                                        font-size: 13px;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            if !root.auth-loading {
                                                if root.auth-register-mode {
                                                    root.submit-register(root.auth-server-url, root.auth-allow-http, root.auth-email, root.auth-password, root.auth-display-name, root.auth-invite);
                                                } else {
                                                    root.submit-login(root.auth-server-url, root.auth-allow-http, root.auth-email, root.auth-password);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.auth-error != "": Text {
                            text: root.auth-error;
                            font-size: 12.5px;
                            color: Theme.error;
                            wrap: word-wrap;
                        }

                        // Submit button
                        Rectangle {
                            height: 44px;
                            border-radius: Theme.pill-radius;
                            background: root.auth-loading ? Theme.surface-highest : (auth-btn-ta.pressed ? Theme.primary-pressed : (auth-btn-ta.has-hover ? Theme.primary-hover : Theme.primary));
                            animate background { duration: 120ms; }
                            Text {
                                text: root.auth-loading ? "Подключение..." : (root.auth-register-mode ? "Создать аккаунт" : "Войти");
                                font-size: 14px;
                                font-weight: 700;
                                color: root.auth-loading ? Theme.on-surface-variant : Theme.on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            auth-btn-ta := TouchArea {
                                mouse-cursor: root.auth-loading ? default : pointer;
                                clicked => {
                                    if !root.auth-loading {
                                        if root.auth-register-mode {
                                            root.submit-register(root.auth-server-url, root.auth-allow-http, root.auth-email, root.auth-password, root.auth-display-name, root.auth-invite);
                                        } else {
                                            root.submit-login(root.auth-server-url, root.auth-allow-http, root.auth-email, root.auth-password);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== MAIN APP SHELL ====================
    VerticalLayout {
        visible: root.show-app;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Top 3-pane Workspace
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // 1. LEFT SIDEBAR
            Rectangle {
                width: root.rail-mode ? 74px : 228px;
                background: Theme.surface-low;

                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;

                    // Brand Logo
                    HorizontalLayout {
                        height: 42px;
                        padding-left: root.rail-mode ? 0px : 8px;
                        spacing: 10px;
                        alignment: root.rail-mode ? center : start;

                        VerticalLayout {
                            alignment: center;
                            WhaleLogo {
                                icon-size: 28px;
                                icon-color: Theme.primary;
                            }
                        }

                        if !root.rail-mode: Text {
                            text: "KWhale";
                            font-family: Theme.display-font;
                            font-size: 19px;
                            font-weight: 700;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { height: 6px; }

                    NavButton {
                        icon-name: "home";
                        label: "Главная";
                        active: root.active-nav == "home";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "home"; root.nav("home"); }
                    }
                    NavButton {
                        icon-name: "search";
                        label: "Поиск";
                        active: root.active-nav == "search";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "search"; root.nav("search"); }
                    }
                    NavButton {
                        icon-name: "library";
                        label: "Медиатека";
                        active: root.active-nav == "library";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "library"; root.nav("library"); }
                    }
                    NavButton {
                        icon-name: "history";
                        label: "История";
                        active: root.active-nav == "history";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "history"; root.nav("history"); }
                    }
                    NavButton {
                        icon-name: "download";
                        label: "Загрузки";
                        active: root.active-nav == "downloads";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "downloads"; root.nav("downloads"); }
                    }

                    // Scrollable Playlists Section
                    if !root.rail-mode: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 4px;
                        padding-top: 12px;

                        Text {
                            text: "Плейлисты";
                            font-family: Theme.text-font;
                            font-size: 11.5px;
                            font-weight: 600;
                            color: Theme.on-surface-variant;
                            height: 20px;
                            vertical-alignment: center;
                        }

                        // Pinned Favorites
                        Rectangle {
                            property <bool> is-fav-active: root.active-nav == "collection" && root.collection-kind == "favorites";
                            height: 44px;
                            border-radius: Theme.row-radius;
                            background: is-fav-active ? Theme.primary-container : (fav-ta.pressed ? Theme.surface-high : (fav-ta.has-hover ? Theme.surface-container : transparent));
                            animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 8px;
                                        background: Theme.primary;
                                        Icon {
                                            x: 8px;
                                            y: 8px;
                                            name: "heart-fill";
                                            icon-size: 16px;
                                            icon-color: Theme.on-primary;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "Избранное";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: is-fav-active ? Theme.on-primary-container : Theme.on-surface;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.liked-count-text;
                                        font-size: 11px;
                                        color: is-fav-active ? Theme.on-primary-container : Theme.on-surface-variant;
                                        opacity: is-fav-active ? 0.85 : 1.0;
                                        overflow: elide;
                                    }
                                }
                            }
                            fav-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-favorites(); }
                            }
                        }

                        sb-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, sb-pl-box.preferred-height);

                            sb-pl-box := VerticalLayout {
                                width: parent.visible-width;
                                alignment: start;
                                spacing: 2px;

                                for pl in root.sidebar-playlists: Rectangle {
                                    property <bool> is-pl-active: root.active-nav == "collection" && root.collection-id == pl.id;
                                    height: 44px;
                                    border-radius: Theme.row-radius;
                                    background: is-pl-active ? Theme.primary-container : (pl-ta.pressed ? Theme.surface-high : (pl-ta.has-hover ? Theme.surface-container : transparent));
                                    animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 8px;
                                                background: Theme.surface-high;
                                                clip: true;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: pl.cover;
                                                    image-fit: cover;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: pl.title;
                                                font-size: 13px;
                                                font-weight: is-pl-active ? 600 : 500;
                                                color: is-pl-active ? Theme.on-primary-container : Theme.on-surface;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: pl.count-text;
                                                font-size: 11px;
                                                color: is-pl-active ? Theme.on-primary-container : Theme.on-surface-variant;
                                                opacity: is-pl-active ? 0.85 : 1.0;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    pl-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-shelf-item("playlist", pl.id); }
                                    }
                                }
                            }
                        }

                        // Create playlist button
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.row-radius;
                            background: newpl-ta.pressed ? Theme.surface-high : (newpl-ta.has-hover ? Theme.surface-container : transparent);
                            animate background { duration: 130ms; }
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: Theme.surface-container;
                                        Icon {
                                            x: 7px;
                                            y: 7px;
                                            name: "plus";
                                            icon-size: 16px;
                                            icon-color: Theme.on-surface-variant;
                                        }
                                    }
                                }
                                Text {
                                    text: "Создать плейлист";
                                    font-size: 12.5px;
                                    font-weight: 500;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }
                            newpl-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-create-playlist(); }
                            }
                        }
                    }

                    if root.rail-mode: Rectangle { vertical-stretch: 1; }

                    Rectangle {
                        height: 1px;
                        background: Theme.outline-variant;
                        opacity: 0.45;
                    }
                    Rectangle { height: 2px; }

                    NavButton {
                        icon-name: "settings";
                        label: "Настройки";
                        active: root.active-nav == "settings";
                        rail-mode: root.rail-mode;
                        clicked => { root.active-nav = "settings"; root.nav("settings"); }
                    }
                }
            }

            if Theme.panel-border-width > 0px: Rectangle {
                width: Theme.panel-border-width;
                background: Theme.outline-variant;
            }

            // 2. CENTER WORKSPACE (TopBar + Scrollable View Host)
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Top App Bar
                Rectangle {
                    height: Theme.top-bar-height;
                    background: Theme.surface;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                        if !Theme.is-gnome: HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "KWhale";
                                font-family: Theme.display-font;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.on-surface-variant;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "›";
                                font-size: 13px;
                                color: Theme.outline;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.active-nav == "home" ? "Главная" :
                                      root.active-nav == "search" ? "Поиск" :
                                      root.active-nav == "library" ? "Медиатека" :
                                      root.active-nav == "history" ? "История" :
                                      root.active-nav == "downloads" ? "Загрузки" :
                                      root.active-nav == "collection" ? root.collection-title : "Настройки";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if Theme.is-gnome: Rectangle { horizontal-stretch: 1; }
                        if !Theme.is-gnome: Rectangle { horizontal-stretch: 0.25; }

                        // Centered Search Bar
                        VerticalLayout {
                            horizontal-stretch: 1.4;
                            min-width: 240px;
                            max-width: 460px;
                            alignment: center;
                            Rectangle {
                                width: 100%;
                                height: 36px;
                                border-radius: Theme.search-radius;
                                background: Theme.surface-high;
                                border-width: (search-inp.has-focus || !Theme.is-gnome) ? 1px : 0px;
                                border-color: search-inp.has-focus ? Theme.primary : Theme.outline-variant;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "search";
                                            icon-size: 17px;
                                            icon-color: Theme.on-surface-variant;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if root.search-query == "" && !search-inp.has-focus: Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "Поиск музыки, исполнителей и плейлистов...";
                                            font-size: 13px;
                                            color: Theme.on-surface-variant;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        search-inp := TextInput {
                                            width: 100%;
                                            height: 100%;
                                            text <=> root.search-query;
                                            font-family: Theme.text-font;
                                            font-size: 13px;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => {
                                                root.search-query-edited(self.text);
                                            }
                                            accepted => {
                                                root.active-nav = "search";
                                                root.search-submitted(self.text, root.search-filter);
                                            }
                                        }
                                    }

                                    if root.search-query != "": VerticalLayout {
                                        alignment: center;
                                        TransportIconButton {
                                            icon-name: "close";
                                            icon-size: 15px;
                                            btn-size: 26px;
                                            clicked => {
                                                root.search-query = "";
                                                root.search-query-edited("");
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Refresh & Profile Avatar
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 10px;

                                TransportIconButton {
                                    icon-name: "refresh";
                                    icon-size: 19px;
                                    btn-size: 34px;
                                    clicked => { root.refresh-home(); }
                                }

                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: Theme.primary-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;
                                    clip: true;

                                    if root.user-has-avatar: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.user-avatar;
                                        image-fit: cover;
                                    }
                                    if !root.user-has-avatar: Text {
                                        text: root.user-initials;
                                        font-family: Theme.display-font;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.on-primary-container;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-nav = "settings"; root.nav("settings"); }
                                    }
                                }
                            }
                        }
                    }
                }

                if Theme.panel-border-width > 0px: Rectangle {
                    height: Theme.panel-border-width;
                    background: Theme.outline-variant;
                }

                // MAIN SCROLLABLE VIEW HOST (single child box + explicit content-height => 100% scrollable)
                main-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, main-scroll-box.preferred-height);

                    main-scroll-box := VerticalLayout {
                        width: parent.visible-width;
                        alignment: start;

                        // -------- HOME VIEW --------
                        if root.active-nav == "home": VerticalLayout {
                            alignment: start;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 2px;
                            padding-bottom: 28px;
                            spacing: 14px;

                            Text {
                                text: root.greeting;
                                font-family: Theme.display-font;
                                font-size: 26px;
                                font-weight: 700;
                                color: Theme.on-surface;
                            }

                            if root.home-loading && root.recent-releases.length == 0 && root.tracks.length == 0: Rectangle {
                                height: 140px;
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                Text {
                                    text: "Загружаем вашу медиатеку и рекомендации...";
                                    font-size: 14px;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if root.home-error != "" && root.recent-releases.length == 0 && root.tracks.length == 0: Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    alignment: start;
                                    Text {
                                        text: root.home-error;
                                        font-size: 14px;
                                        color: Theme.error;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: err-retry-ta.pressed ? Theme.primary-pressed : (err-retry-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                Text { text: "Повторить"; font-size: 13px; font-weight: 600; color: Theme.on-primary; vertical-alignment: center; }
                                            }
                                            err-retry-ta := TouchArea { mouse-cursor: pointer; clicked => { root.refresh-home(); } }
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: err-dl-ta.pressed ? Theme.surface-highest : (err-dl-ta.has-hover ? Theme.surface-high : Theme.surface-low);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                Text { text: "Скачанные треки"; font-size: 13px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; }
                                            }
                                            err-dl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.active-nav = "downloads"; root.nav("downloads"); } }
                                        }
                                    }
                                }
                            }

                            // HERO ROW (Continue Listening + My Wave)
                            HorizontalLayout {
                                height: 164px;
                                spacing: 16px;

                                // Left Hero Card
                                Rectangle {
                                    horizontal-stretch: 1.85;
                                    border-radius: Theme.hero-radius;
                                    background: Theme.primary-container;
                                    border-width: Theme.card-border-width;
                                    border-color: Theme.outline-variant;
                                    clip: true;

                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.hero-backdrop;
                                        image-fit: cover;
                                    }

                                    HorizontalLayout {
                                        padding: 18px;
                                        spacing: 18px;

                                        if root.has-hero-cover: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 124px;
                                                height: 124px;
                                                border-radius: Theme.is-gnome ? 14px : 8px;
                                                background: Theme.widget-placeholder;
                                                border-width: 1px;
                                                border-color: Theme.overlay-border;
                                                clip: true;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    preferred-width: 0px;
                                                    preferred-height: 0px;
                                                    source: root.hero-cover;
                                                    image-fit: cover;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                width: 100%;
                                                alignment: space-between;
                                                Rectangle {
                                                    horizontal-stretch: 0;
                                                    height: 28px;
                                                    border-radius: Theme.pill-radius;
                                                    background: Theme.overlay-scrim;
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Icon { name: "play"; icon-size: 13px; icon-color: Theme.overlay-fg; }
                                                        }
                                                        Text {
                                                            text: root.hero-badge;
                                                            font-size: 11.5px;
                                                            font-weight: 600;
                                                            color: Theme.overlay-fg;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        for dot-idx in [0, 1, 2]: Rectangle {
                                                            width: dot-idx == root.hero-slide ? 16px : 7px;
                                                            height: 7px;
                                                            border-radius: 3.5px;
                                                            background: dot-idx == root.hero-slide ? Theme.overlay-fg : Theme.overlay-fg.with-alpha(0.38);
                                                            animate width { duration: 150ms; }
                                                            TouchArea {
                                                                mouse-cursor: pointer;
                                                                clicked => {
                                                                    root.hero-slide = dot-idx;
                                                                    root.cycle-hero-slide(dot-idx);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Rectangle { vertical-stretch: 1; }

                                            HorizontalLayout {
                                                width: 100%;
                                                spacing: 16px;
                                                alignment: stretch;

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: end;
                                                    spacing: 4px;

                                                    Text {
                                                        text: root.hero-title != "" ? root.hero-title : "Ваша музыка";
                                                        font-family: Theme.display-font;
                                                        font-size: 22px;
                                                        font-weight: 700;
                                                        color: Theme.overlay-fg;
                                                        overflow: elide;
                                                    }

                                                    HorizontalLayout {
                                                        width: 100%;
                                                        alignment: space-between;
                                                        Text {
                                                            text: root.hero-artist != "" ? root.hero-artist : "Нажмите Play для запуска";
                                                            font-size: 13px;
                                                            font-weight: 500;
                                                            color: Theme.overlay-fg-muted;
                                                            overflow: elide;
                                                        }
                                                        if root.hero-time != "": Text {
                                                            text: root.hero-time;
                                                            font-size: 12px;
                                                            font-weight: 500;
                                                            color: Theme.overlay-fg-muted;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Rectangle { height: 4px; }

                                                    Rectangle {
                                                        width: 100%;
                                                        height: 4px;
                                                        border-radius: 2px;
                                                        background: Theme.overlay-track;
                                                        Rectangle {
                                                            x: 0px;
                                                            width: parent.width * clamp(root.hero-progress, 0.0, 1.0);
                                                            height: 4px;
                                                            border-radius: 2px;
                                                            background: Theme.overlay-accent;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: end;
                                                    Rectangle {
                                                        width: 48px;
                                                        height: 48px;
                                                        border-radius: Theme.is-gnome ? 24px : 12px;
                                                        background: hero-play-ta.pressed ? Theme.primary-pressed : (hero-play-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                                        animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                                        Icon {
                                                            x: root.playing ? 13px : 14px;
                                                            y: 13px;
                                                            name: root.playing ? "pause" : "play";
                                                            icon-size: 22px;
                                                            icon-color: Theme.on-primary;
                                                        }
                                                        hero-play-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.play-hero(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Right Hero Card (My Wave)
                                Rectangle {
                                    horizontal-stretch: 1.0;
                                    min-width: 240px;
                                    border-radius: Theme.hero-radius;
                                    background: @linear-gradient(142deg, Theme.primary-container, Theme.secondary-container 65%, Theme.surface-container);
                                    border-width: Theme.card-border-width;
                                    border-color: Theme.outline-variant;
                                    clip: true;

                                    Rectangle {
                                        x: parent.width - 175px;
                                        y: -60px;
                                        width: 280px;
                                        height: 280px;
                                        border-radius: 140px;
                                        background: @linear-gradient(180deg, Theme.primary.with-alpha(0.16), Theme.primary.with-alpha(0.02));
                                    }
                                    Rectangle {
                                        x: parent.width - 125px;
                                        y: 35px;
                                        width: 240px;
                                        height: 240px;
                                        border-radius: 120px;
                                        background: @linear-gradient(160deg, Theme.primary.with-alpha(0.11), transparent);
                                    }

                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 9px;
                                                background: Theme.primary;
                                                Icon { x: 6px; y: 6px; name: "wave"; icon-size: 18px; icon-color: Theme.on-primary; }
                                            }
                                            Text {
                                                text: "Моя волна";
                                                font-family: Theme.display-font;
                                                font-size: 17px;
                                                font-weight: 700;
                                                color: Theme.on-primary-container;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: "Персональная подборка на основе ваших предпочтений";
                                            font-size: 12px;
                                            color: Theme.on-primary-container;
                                            opacity: 0.78;
                                            wrap: word-wrap;
                                        }

                                        Rectangle { vertical-stretch: 1; }

                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                horizontal-stretch: 0;
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: wave-ta.pressed ? Theme.primary-pressed : (wave-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                                animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                                HorizontalLayout {
                                                    padding-left: 14px;
                                                    padding-right: 18px;
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Icon { name: "play"; icon-size: 15px; icon-color: Theme.on-primary; }
                                                    }
                                                    Text {
                                                        text: "Слушать";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.on-primary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                wave-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.start-wave(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // AI Prompt Mix Bar (mirrors HomeScreen.kt "Собери плейлист под настроение")
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: prompt-inp.has-focus ? Theme.primary : Theme.outline-variant;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 8px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "sparkles";
                                            icon-size: 18px;
                                            icon-color: Theme.primary;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        if root.prompt-text == "" && !prompt-inp.has-focus: Text {
                                            width: 100%; height: 100%;
                                            text: "Собрать плейлист под настроение (например: спокойный джаз на вечер, без рэпа)...";
                                            font-size: 12.5px;
                                            color: Theme.on-surface-variant;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        prompt-inp := TextInput {
                                            width: 100%; height: 100%;
                                            text <=> root.prompt-text;
                                            font-size: 12.5px;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accepted => {
                                                if root.prompt-text != "" && !root.prompt-loading {
                                                    root.submit-prompt-mix(root.prompt-text);
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: Theme.pill-radius;
                                        background: (root.prompt-text == "" || root.prompt-loading) ? Theme.surface-high : (pm-ta.pressed ? Theme.primary-pressed : (pm-ta.has-hover ? Theme.primary-hover : Theme.primary));
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            Text {
                                                text: root.prompt-loading ? "Собираем..." : "Собрать";
                                                font-size: 12.5px;
                                                font-weight: 600;
                                                color: (root.prompt-text == "" || root.prompt-loading) ? Theme.on-surface-variant : Theme.on-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        pm-ta := TouchArea {
                                            mouse-cursor: (root.prompt-text == "" || root.prompt-loading) ? default : pointer;
                                            clicked => {
                                                if root.prompt-text != "" && !root.prompt-loading {
                                                    root.submit-prompt-mix(root.prompt-text);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Mood & Personal Mix Chips
                            if root.mix-chips.length > 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for mx in root.mix-chips: Rectangle {
                                    height: 32px;
                                    border-radius: Theme.pill-radius;
                                    background: mx-ta.pressed ? Theme.surface-highest : (mx-ta.has-hover ? Theme.primary-container : Theme.surface-container);
                                    animate background { duration: 120ms; }
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: mx.title;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: mx-ta.has-hover ? Theme.on-primary-container : Theme.on-surface;
                                            vertical-alignment: center;
                                        }
                                    }
                                    mx-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.play-mix(mx.id); }
                                    }
                                }
                            }

                            // SHELF 1
                            if root.recent-releases.length > 0: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text {
                                        text: root.recent-section-title;
                                        font-family: Theme.display-font;
                                        font-size: 18.5px;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    if root.recent-has-shift: HorizontalLayout {
                                        spacing: 4px;
                                        TransportIconButton { icon-name: "back"; icon-size: 15px; btn-size: 26px; clicked => { root.shift-shelf("recent", -1); } }
                                        TransportIconButton { icon-name: "chevron-right"; icon-size: 16px; btn-size: 26px; clicked => { root.shift-shelf("recent", 1); } }
                                    }
                                }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for al in root.recent-releases: AlbumCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: al;
                                        activated => { root.open-shelf-item(al.kind, al.id); }
                                    }
                                }
                            }

                            // SHELF 2
                            if root.chart-items.length > 0: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: space-between;
                                    Text {
                                        text: root.chart-section-title;
                                        font-family: Theme.display-font;
                                        font-size: 18.5px;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        if root.chart-has-shift: HorizontalLayout {
                                            spacing: 4px;
                                            TransportIconButton { icon-name: "back"; icon-size: 15px; btn-size: 26px; clicked => { root.shift-shelf("chart", -1); } }
                                            TransportIconButton { icon-name: "chevron-right"; icon-size: 16px; btn-size: 26px; clicked => { root.shift-shelf("chart", 1); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 2px;
                                            Text { text: "Показать всё"; font-size: 12.5px; font-weight: 600; color: Theme.primary; vertical-alignment: center; }
                                            VerticalLayout { alignment: center; Icon { name: "chevron-right"; icon-size: 16px; icon-color: Theme.primary; } }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.active-nav = "library"; root.nav("library"); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for ch in root.chart-items: AlbumCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: ch;
                                        activated => { root.open-shelf-item(ch.kind, ch.id); }
                                    }
                                }
                            }

                            // TRACKS SECTION
                            if root.tracks.length > 0: VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.tracks-section-title;
                                    font-family: Theme.display-font;
                                    font-size: 18.5px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    for tr[idx] in root.tracks: TrackRow {
                                        index: idx;
                                        item: tr;
                                        play => { root.play-track("home", idx); }
                                        toggle-like => { root.toggle-like-track("home", idx); }
                                        open-menu => { root.open-track-menu("home", idx); }
                                    }
                                }
                            }
                        }

                        // -------- SEARCH VIEW --------
                        if root.active-nav == "search": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Поиск";
                                font-family: Theme.display-font;
                                font-size: 28px;
                                font-weight: 700;
                                color: Theme.on-surface;
                            }

                            if root.search-query != "": HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                for f in [
                                    { id: "all", label: "Все" },
                                    { id: "tracks", label: "Треки" },
                                    { id: "albums", label: "Альбомы" },
                                    { id: "artists", label: "Артисты" },
                                    { id: "playlists", label: "Плейлисты" },
                                ]: Rectangle {
                                    property <bool> is-sel: root.search-filter == f.id;
                                    height: 32px;
                                    border-radius: Theme.pill-radius;
                                    background: is-sel ? Theme.primary-container : (sf-ta.pressed ? Theme.surface-highest : (sf-ta.has-hover ? Theme.surface-high : Theme.surface-container));
                                    border-width: 1px;
                                    border-color: is-sel ? Theme.primary : Theme.outline-variant;
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        Text {
                                            text: f.label;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: is-sel ? Theme.on-primary-container : Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    sf-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-filter = f.id;
                                            root.select-search-filter(f.id);
                                        }
                                    }
                                }
                            }

                            if root.search-query != "" && root.search-suggestions.length > 0: HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                for sg in root.search-suggestions: Rectangle {
                                    height: 28px;
                                    border-radius: Theme.pill-radius;
                                    background: sg-ta.pressed ? Theme.surface-highest : (sg-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: sg;
                                            font-size: 12px;
                                            color: sg-ta.has-hover ? Theme.on-primary-container : Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    sg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.apply-search-chip(sg); } }
                                }
                            }

                            if root.search-refining: Text {
                                text: "Уточняем результаты на внешних источниках...";
                                font-size: 12px;
                                color: Theme.primary;
                            }

                            if root.search-query == "": VerticalLayout {
                                spacing: 20px;
                                alignment: start;

                                if root.search-history.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        width: 100%;
                                        alignment: space-between;
                                        Text { text: "Недавние запросы"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                        Rectangle {
                                            height: 28px;
                                            border-radius: Theme.pill-radius;
                                            background: ch-ta.pressed ? Theme.surface-highest : (ch-ta.has-hover ? Theme.surface-high : transparent);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: "Очистить";
                                                    font-size: 12.5px;
                                                    font-weight: 600;
                                                    color: Theme.primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            ch-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear-search-history(); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        for hq in root.search-history: Rectangle {
                                            height: 32px;
                                            border-radius: Theme.pill-radius;
                                            background: hq-ta.pressed ? Theme.surface-highest : (hq-ta.has-hover ? Theme.surface-high : Theme.surface-container);
                                            border-width: 1px;
                                            border-color: Theme.outline-variant;
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Text { text: hq; font-size: 12.5px; color: Theme.on-surface; vertical-alignment: center; }
                                            }
                                            hq-ta := TouchArea { mouse-cursor: pointer; clicked => { root.apply-search-chip(hq); } }
                                        }
                                    }
                                }

                                if root.search-genres.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Жанры"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        for gr in root.search-genres: Rectangle {
                                            height: 32px;
                                            border-radius: Theme.pill-radius;
                                            background: gr-ta.pressed ? Theme.surface-highest : (gr-ta.has-hover ? Theme.primary-container : Theme.secondary-container);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                Text {
                                                    text: gr.name;
                                                    font-size: 12.5px;
                                                    font-weight: 600;
                                                    color: gr-ta.has-hover ? Theme.on-primary-container : Theme.on-secondary-container;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            gr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.apply-search-chip(gr.name); } }
                                        }
                                    }
                                }

                                if root.search-artists.length > 0: VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "Популярные артисты"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                    HorizontalLayout {
                                        width: 100%;
                                        alignment: start;
                                        spacing: 12px;
                                        for ar in root.search-artists: ArtistCard {
                                            width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                            item: ar;
                                            activated => { root.open-artist(ar.id); }
                                        }
                                    }
                                }

                                if root.search-history.length == 0 && root.search-genres.length == 0 && root.search-artists.length == 0: VerticalLayout {
                                    padding-top: 24px;
                                    padding-bottom: 24px;
                                    alignment: center;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Icon { name: "search"; icon-size: 28px; icon-color: Theme.on-surface-variant; }
                                    }
                                    Text { text: "Введите запрос в поле поиска сверху"; font-size: 14px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; }
                                    Text { text: "Поиск работает по трекам, альбомам, артистам и плейлистам"; font-size: 12.5px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                                }
                            }

                            if root.search-loading && root.search-tracks.length == 0 && root.search-shelves.length == 0: Text {
                                text: "Поиск...";
                                font-size: 14px;
                                color: Theme.on-surface-variant;
                            }
                            if root.search-error != "": Text {
                                text: root.search-error;
                                font-size: 13.5px;
                                color: Theme.error;
                            }

                            if root.search-query != "" && root.search-artists.length > 0 && (root.search-filter == "all" || root.search-filter == "artists"): VerticalLayout {
                                spacing: 10px;
                                Text { text: "Артисты"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for ar in root.search-artists: ArtistCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: ar;
                                        activated => { root.open-artist(ar.id); }
                                    }
                                }
                            }

                            if root.search-query != "" && root.search-shelves.length > 0: VerticalLayout {
                                spacing: 10px;
                                Text { text: "Альбомы и плейлисты"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for al in root.search-shelves: AlbumCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: al;
                                        activated => { root.open-shelf-item(al.kind, al.id); }
                                    }
                                }
                            }

                            if root.search-query != "" && root.search-tracks.length > 0: VerticalLayout {
                                spacing: 4px;
                                Text { text: "Треки"; font-family: Theme.display-font; font-size: 17px; font-weight: 700; color: Theme.on-surface; }
                                for tr[idx] in root.search-tracks: TrackRow {
                                    index: idx;
                                    item: tr;
                                    play => { root.play-track("search", idx); }
                                    toggle-like => { root.toggle-like-track("search", idx); }
                                    open-menu => { root.open-track-menu("search", idx); }
                                }
                            }

                            if root.search-query != "" && !root.search-loading && root.search-tracks.length == 0 && root.search-shelves.length == 0 && root.search-artists.length == 0 && root.search-error == "": Text {
                                text: "Ничего не найдено по вашему запросу";
                                font-size: 14px;
                                color: Theme.on-surface-variant;
                            }
                        }

                        // -------- LIBRARY VIEW --------
                        if root.active-nav == "library": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                width: 100%;
                                alignment: space-between;
                                Text {
                                    text: "Медиатека";
                                    font-family: Theme.display-font;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Theme.pill-radius;
                                        background: lib-np-ta.pressed ? Theme.surface-highest : (lib-np-ta.has-hover ? Theme.primary-container : Theme.surface-container);
                                        border-width: 1px;
                                        border-color: Theme.outline-variant;
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            VerticalLayout { alignment: center; Icon { name: "plus"; icon-size: 15px; icon-color: lib-np-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; } }
                                            Text { text: "Создать плейлист"; font-size: 12.5px; font-weight: 600; color: lib-np-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; vertical-alignment: center; }
                                        }
                                        lib-np-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-create-playlist(); } }
                                    }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Theme.pill-radius;
                                        background: lib-shuf-ta.pressed ? Theme.primary-pressed : (lib-shuf-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            VerticalLayout { alignment: center; Icon { name: "shuffle"; icon-size: 15px; icon-color: Theme.on-primary; } }
                                            Text { text: "Перемешать"; font-size: 12.5px; font-weight: 600; color: Theme.on-primary; vertical-alignment: center; }
                                        }
                                        lib-shuf-ta := TouchArea { mouse-cursor: pointer; clicked => { root.shuffle-library(); } }
                                    }
                                }
                            }

                            // Primary Library View Segmented Track (visually distinct from secondary sort controls)
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 40px;
                                    border-radius: Theme.pill-radius;
                                    background: Theme.surface-low;
                                    HorizontalLayout {
                                        padding: 4px;
                                        spacing: 4px;
                                        for seg in [
                                            { id: "collections", label: "Коллекции" },
                                            { id: "playlists", label: "Плейлисты" },
                                            { id: "albums", label: "Альбомы" },
                                            { id: "tracks", label: "Треки" },
                                        ]: Rectangle {
                                            property <bool> is-sel: root.library-tab == seg.id;
                                            height: 32px;
                                            border-radius: max(4px, Theme.pill-radius - 2px);
                                            background: is-sel ? Theme.primary-container : (seg-ta.pressed ? Theme.surface-highest : (seg-ta.has-hover ? Theme.surface-high : transparent));
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                Text {
                                                    text: seg.label;
                                                    font-size: 12.5px;
                                                    font-weight: is-sel ? 700 : 500;
                                                    color: is-sel ? Theme.on-primary-container : Theme.on-surface-variant;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            seg-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.library-tab = seg.id;
                                                    root.select-library-tab(seg.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.library-tab != "tracks" && root.library-collections.length > 0: HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                spacing: 12px;
                                for al in root.library-collections: AlbumCard {
                                    width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                    item: al;
                                    activated => { root.open-shelf-item(al.kind, al.id); }
                                }
                            }
                            if root.library-tab != "tracks" && root.library-collections-row2.length > 0: HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                spacing: 12px;
                                for al in root.library-collections-row2: AlbumCard {
                                    width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                    item: al;
                                    activated => { root.open-shelf-item(al.kind, al.id); }
                                }
                            }

                            if root.library-tab == "tracks" || root.library-tab == "collections": VerticalLayout {
                                spacing: 12px;
                                padding-top: root.library-tab == "collections" && root.library-collections.length > 0 ? 8px : 0px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 240px;
                                        height: 34px;
                                        border-radius: Theme.search-radius;
                                        background: Theme.surface-high;
                                        border-width: 1px;
                                        border-color: lf-inp.has-focus ? Theme.primary : Theme.outline-variant;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Rectangle {
                                                if root.library-filter-query == "" && !lf-inp.has-focus: Text {
                                                    width: 100%; height: 100%;
                                                    text: "Фильтр по трекам...";
                                                    font-size: 12.5px;
                                                    color: Theme.on-surface-variant;
                                                    vertical-alignment: center;
                                                }
                                                lf-inp := TextInput {
                                                    width: 100%; height: 100%;
                                                    text <=> root.library-filter-query;
                                                    font-size: 12.5px;
                                                    color: Theme.on-surface;
                                                    vertical-alignment: center;
                                                    single-line: true;
                                                    edited => { root.library-filter-changed(self.text); }
                                                }
                                            }
                                        }
                                    }
                                    for sr in [
                                        { id: "default", label: "По умолчанию" },
                                        { id: "added", label: "Новые" },
                                        { id: "title", label: "Название" },
                                        { id: "artist", label: "Артист" },
                                    ]: Rectangle {
                                        property <bool> is-sel: root.library-sort == sr.id;
                                        height: 34px;
                                        border-radius: Theme.pill-radius;
                                        background: is-sel ? Theme.secondary-container : (sr-ta.pressed ? Theme.surface-highest : (sr-ta.has-hover ? Theme.surface-high : transparent));
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: sr.label;
                                                font-size: 12px;
                                                font-weight: is-sel ? 600 : 500;
                                                color: is-sel ? Theme.on-secondary-container : Theme.on-surface-variant;
                                                vertical-alignment: center;
                                            }
                                        }
                                        sr-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.library-sort = sr.id;
                                                root.select-library-sort(sr.id);
                                            }
                                        }
                                    }
                                }

                                for tr[idx] in root.library-tracks: TrackRow {
                                    index: idx;
                                    item: tr;
                                    play => { root.play-track("library", idx); }
                                    toggle-like => { root.toggle-like-track("library", idx); }
                                    open-menu => { root.open-track-menu("library", idx); }
                                }

                                if !root.library-loading && root.library-tracks.length == 0: VerticalLayout {
                                    padding-top: 24px;
                                    padding-bottom: 24px;
                                    spacing: 8px;
                                    HorizontalLayout { alignment: center; Icon { name: "library"; icon-size: 28px; icon-color: Theme.on-surface-variant; } }
                                    Text { text: "Треки в медиатеке не найдены"; font-size: 14px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; }
                                }

                                if root.library-has-more: HorizontalLayout {
                                    alignment: center;
                                    padding-top: 8px;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Theme.pill-radius;
                                        background: lib-more-ta.pressed ? Theme.surface-highest : (lib-more-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 20px;
                                            Text {
                                                text: "Загрузить ещё";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: lib-more-ta.has-hover ? Theme.on-primary-container : Theme.primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        lib-more-ta := TouchArea { mouse-cursor: pointer; clicked => { root.load-more-library(); } }
                                    }
                                }
                            }
                        }

                        // -------- HISTORY VIEW --------
                        if root.active-nav == "history": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                width: 100%;
                                alignment: space-between;
                                Text {
                                    text: "История прослушиваний";
                                    font-family: Theme.display-font;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                if root.history-tracks.length > 0: Rectangle {
                                    height: 36px;
                                    border-radius: Theme.pill-radius;
                                    background: chist-ta.pressed ? Theme.surface-highest : (chist-ta.has-hover ? Theme.surface-high : Theme.surface-container);
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { name: "trash"; icon-size: 15px; icon-color: Theme.on-surface-variant; } }
                                        Text { text: "Очистить историю"; font-size: 12.5px; font-weight: 500; color: Theme.on-surface-variant; vertical-alignment: center; }
                                    }
                                    chist-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear-history(); } }
                                }
                            }

                            if root.history-loading && root.history-tracks.length == 0: Text {
                                text: "Загрузка истории...";
                                font-size: 14px;
                                color: Theme.on-surface-variant;
                            }
                            if !root.history-loading && root.history-tracks.length == 0: VerticalLayout {
                                padding-top: 32px;
                                padding-bottom: 32px;
                                spacing: 8px;
                                HorizontalLayout { alignment: center; Icon { name: "history"; icon-size: 32px; icon-color: Theme.on-surface-variant; } }
                                Text { text: "История пока пуста"; font-size: 15px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; }
                                Text { text: "Прослушанные треки появятся здесь автоматически"; font-size: 13px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                for tr[idx] in root.history-tracks: TrackRow {
                                    index: idx;
                                    item: tr;
                                    play => { root.play-history-track(idx); }
                                    toggle-like => { root.toggle-like-track("history", idx); }
                                    open-menu => { root.open-track-menu("history", idx); }
                                }
                            }

                            if root.history-has-more: HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 36px;
                                    border-radius: Theme.pill-radius;
                                    background: hm-ta.pressed ? Theme.surface-highest : (hm-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        Text { text: "Загрузить ещё"; font-size: 13px; font-weight: 600; color: hm-ta.has-hover ? Theme.on-primary-container : Theme.primary; vertical-alignment: center; }
                                    }
                                    hm-ta := TouchArea { mouse-cursor: pointer; clicked => { root.load-more-history(); } }
                                }
                            }
                        }

                        // -------- DOWNLOADS VIEW --------
                        if root.active-nav == "downloads": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                width: 100%;
                                alignment: space-between;
                                Text {
                                    text: "Загрузки офлайн";
                                    font-family: Theme.display-font;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                if root.download-items.length > 0: HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Theme.pill-radius;
                                        background: dlp-ta.pressed ? Theme.primary-pressed : (dlp-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;
                                            VerticalLayout { alignment: center; Icon { name: "play"; icon-size: 15px; icon-color: Theme.on-primary; } }
                                            Text { text: "Играть всё"; font-size: 12.5px; font-weight: 600; color: Theme.on-primary; vertical-alignment: center; }
                                        }
                                        dlp-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play-all-downloads(); } }
                                    }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Theme.pill-radius;
                                        background: dlc-ta.pressed ? Theme.surface-highest : (dlc-ta.has-hover ? Theme.surface-high : Theme.surface-container);
                                        border-width: 1px;
                                        border-color: Theme.outline-variant;
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            Text { text: "Очистить все"; font-size: 12.5px; font-weight: 600; color: Theme.error; vertical-alignment: center; }
                                        }
                                        dlc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear-all-downloads(); } }
                                    }
                                }
                            }

                            if root.download-items.length == 0: VerticalLayout {
                                padding-top: 32px;
                                padding-bottom: 32px;
                                spacing: 8px;
                                HorizontalLayout { alignment: center; Icon { name: "download"; icon-size: 32px; icon-color: Theme.on-surface-variant; } }
                                Text { text: "Пока нет скачанных треков"; font-size: 15px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; }
                                Text {
                                    text: "Откройте меню любого трека (•••) или нажмите «Скачать все» в альбоме и плейлисте";
                                    font-size: 13px;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                for dl[idx] in root.download-items: Rectangle {
                                    height: 60px;
                                    border-radius: Theme.row-radius;
                                    background: dl-ta.pressed ? Theme.surface-high : (dl-ta.has-hover ? Theme.surface-container : transparent);
                                    animate background { duration: 120ms; }
                                    dl-ta := TouchArea {
                                        mouse-cursor: dl.active ? default : pointer;
                                        clicked => {
                                            if !dl.active && !dl.failed {
                                                root.play-download-track(idx);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 42px;
                                                height: 42px;
                                                border-radius: 8px;
                                                clip: true;
                                                Image { width: 100%; height: 100%; source: dl.cover; image-fit: cover; }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 3px;
                                            Text { text: dl.title; font-size: 14px; font-weight: 600; color: Theme.on-surface; overflow: elide; }
                                            Text {
                                                text: dl.artist + (dl.status-text != "" ? (" · " + dl.status-text) : "");
                                                font-size: 12px;
                                                color: dl.failed ? Theme.error : Theme.on-surface-variant;
                                                overflow: elide;
                                            }
                                            if dl.active: Rectangle {
                                                width: 100%;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: Theme.surface-high;
                                                Rectangle { x: 0px; width: parent.width * clamp(dl.progress, 0.0, 1.0); height: 3px; border-radius: 1.5px; background: Theme.primary; }
                                            }
                                        }
                                        if dl.failed: VerticalLayout {
                                            alignment: center;
                                            TransportIconButton {
                                                icon-name: "refresh";
                                                icon-size: 18px;
                                                btn-size: 32px;
                                                clicked => { root.retry-download(dl.id); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            TransportIconButton {
                                                icon-name: "trash";
                                                icon-size: 18px;
                                                btn-size: 32px;
                                                clicked => { root.remove-download(dl.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // -------- COLLECTION & ARTIST DETAIL VIEW --------
                        if root.active-nav == "collection": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 18px;

                            HorizontalLayout {
                                alignment: start;
                                spacing: 12px;
                                Rectangle {
                                    height: 34px;
                                    border-radius: Theme.pill-radius;
                                    background: back-ta.pressed ? Theme.surface-highest : (back-ta.has-hover ? Theme.surface-high : Theme.surface-container);
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { name: "back"; icon-size: 16px; icon-color: Theme.on-surface; } }
                                        Text { text: "Назад"; font-size: 12.5px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; }
                                    }
                                    back-ta := TouchArea { mouse-cursor: pointer; clicked => { root.navigate-back(); } }
                                }
                                if root.collection-sync-text != "": Text {
                                    text: root.collection-sync-text;
                                    font-size: 12.5px;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                border-radius: Theme.hero-radius;
                                background: Theme.surface-container;
                                border-width: Theme.card-border-width;
                                border-color: Theme.outline-variant;

                                HorizontalLayout {
                                    padding: 20px;
                                    spacing: 20px;

                                    Rectangle {
                                        width: 152px;
                                        height: 152px;
                                        border-radius: root.collection-kind == "artist" ? 76px : Theme.card-radius;
                                        background: Theme.surface-high;
                                        clip: true;
                                        Image { width: 100%; height: 100%; source: root.collection-cover; image-fit: cover; }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 6px;

                                        Text {
                                            text: root.collection-title;
                                            font-family: Theme.display-font;
                                            font-size: 26px;
                                            font-weight: 700;
                                            color: Theme.on-surface;
                                            overflow: elide;
                                        }
                                        if root.collection-subtitle != "": Text {
                                            text: root.collection-subtitle;
                                            font-size: 14px;
                                            font-weight: 500;
                                            color: root.collection-artist-id != "" ? Theme.primary : Theme.on-surface-variant;
                                            TouchArea {
                                                mouse-cursor: root.collection-artist-id != "" ? pointer : default;
                                                clicked => {
                                                    if root.collection-artist-id != "" {
                                                        root.open-artist(root.collection-artist-id);
                                                    }
                                                }
                                            }
                                        }
                                        if root.collection-meta != "": Text {
                                            text: root.collection-meta;
                                            font-size: 12.5px;
                                            color: Theme.on-surface-variant;
                                        }

                                        Rectangle { height: 6px; }

                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;

                                            Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: col-play-ta.pressed ? Theme.primary-pressed : (col-play-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                                animate background { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 20px;
                                                    spacing: 8px;
                                                    VerticalLayout { alignment: center; Icon { name: "play"; icon-size: 16px; icon-color: Theme.on-primary; } }
                                                    Text { text: "Слушать"; font-size: 13px; font-weight: 600; color: Theme.on-primary; vertical-alignment: center; }
                                                }
                                                col-play-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play-collection(); } }
                                            }

                                            Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: col-shuf-ta.pressed ? Theme.surface-highest : (col-shuf-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                                animate background { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    spacing: 8px;
                                                    VerticalLayout { alignment: center; Icon { name: "shuffle"; icon-size: 15px; icon-color: col-shuf-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; } }
                                                    Text { text: "Перемешать"; font-size: 12.5px; font-weight: 600; color: col-shuf-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; vertical-alignment: center; }
                                                }
                                                col-shuf-ta := TouchArea { mouse-cursor: pointer; clicked => { root.shuffle-collection(); } }
                                            }

                                            if !root.collection-can-edit && root.collection-kind != "favorites" && root.collection-kind != "mix": Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: root.collection-saved ? (col-save-ta.pressed ? Theme.surface-highest : Theme.primary-container) : (col-save-ta.pressed ? Theme.surface-highest : (col-save-ta.has-hover ? Theme.primary-container : Theme.surface-high));
                                                animate background { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Icon {
                                                            name: root.collection-saved ? "heart-fill" : "heart";
                                                            icon-size: 15px;
                                                            icon-color: (root.collection-saved || col-save-ta.has-hover) ? Theme.on-primary-container : Theme.on-surface;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.collection-saved ? "В библиотеке" : "Сохранить";
                                                        font-size: 12.5px;
                                                        font-weight: 600;
                                                        color: (root.collection-saved || col-save-ta.has-hover) ? Theme.on-primary-container : Theme.on-surface;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                col-save-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-save-collection(); } }
                                            }

                                            if root.collection-tracks.length > 0 && root.collection-kind != "artist": Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: col-dl-ta.pressed ? Theme.surface-highest : (col-dl-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                                animate background { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    spacing: 8px;
                                                    VerticalLayout { alignment: center; Icon { name: "download"; icon-size: 15px; icon-color: col-dl-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; } }
                                                    Text { text: "Скачать все"; font-size: 12.5px; font-weight: 600; color: col-dl-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; vertical-alignment: center; }
                                                }
                                                col-dl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.download-all-collection(); } }
                                            }

                                            if root.collection-can-edit: Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: col-ren-ta.pressed ? Theme.surface-highest : (col-ren-ta.has-hover ? Theme.primary-container : Theme.surface-high);
                                                animate background { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    spacing: 6px;
                                                    VerticalLayout { alignment: center; Icon { name: "edit"; icon-size: 15px; icon-color: col-ren-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; } }
                                                    Text { text: "Переименовать"; font-size: 12.5px; color: col-ren-ta.has-hover ? Theme.on-primary-container : Theme.on-surface; vertical-alignment: center; }
                                                }
                                                col-ren-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-rename-collection(); } }
                                            }

                                            if root.collection-can-edit: Rectangle {
                                                height: 36px;
                                                border-radius: Theme.pill-radius;
                                                background: Theme.error-container;
                                                opacity: col-del-ta.pressed ? 0.78 : (col-del-ta.has-hover ? 0.9 : 1.0);
                                                animate opacity { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    Text { text: "Удалить"; font-size: 12.5px; font-weight: 600; color: Theme.error; vertical-alignment: center; }
                                                }
                                                col-del-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-collection(); } }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.collection-loading && root.collection-tracks.length == 0: Text {
                                text: "Загрузка...";
                                font-size: 14px;
                                color: Theme.on-surface-variant;
                            }

                            if root.collection-tracks.length > 0: VerticalLayout {
                                spacing: 4px;
                                if root.collection-kind == "artist": Text {
                                    text: "Популярные треки";
                                    font-family: Theme.display-font;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                for tr[idx] in root.collection-tracks: TrackRow {
                                    index: idx;
                                    item: tr;
                                    play => { root.play-collection-track(idx); }
                                    toggle-like => { root.toggle-like-track("collection", idx); }
                                    open-menu => { root.open-track-menu("collection", idx); }
                                }
                            }

                            if root.collection-albums.length > 0: VerticalLayout {
                                spacing: 10px;
                                Text { text: "Альбомы"; font-family: Theme.display-font; font-size: 18px; font-weight: 700; color: Theme.on-surface; }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for al in root.collection-albums: AlbumCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: al;
                                        activated => { root.open-shelf-item(al.kind, al.id); }
                                    }
                                }
                            }

                            if root.collection-singles.length > 0: VerticalLayout {
                                spacing: 10px;
                                Text { text: "Синглы и EP"; font-family: Theme.display-font; font-size: 18px; font-weight: 700; color: Theme.on-surface; }
                                HorizontalLayout {
                                    width: 100%;
                                    alignment: start;
                                    spacing: 12px;
                                    for sg in root.collection-singles: AlbumCard {
                                        width: clamp((parent.width - 48px) / 5, 110px, 240px);
                                        item: sg;
                                        activated => { root.open-shelf-item(sg.kind, sg.id); }
                                    }
                                }
                            }
                        }

                        // -------- SETTINGS & PROFILE VIEW --------
                        if root.active-nav == "settings": VerticalLayout {
                            alignment: start;
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Профиль и настройки";
                                font-family: Theme.display-font;
                                font-size: 28px;
                                font-weight: 700;
                                color: Theme.on-surface;
                            }

                            // Account & Profile Stats Card
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 16px;

                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        background: Theme.primary-container;
                                        clip: true;
                                        if root.user-has-avatar: Image { width: 100%; height: 100%; source: root.user-avatar; image-fit: cover; }
                                        if !root.user-has-avatar: Text {
                                            text: root.user-initials;
                                            font-family: Theme.display-font;
                                            font-size: 18px;
                                            font-weight: 700;
                                            color: Theme.on-primary-container;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: root.authenticated ? root.user-name : "Гость (демо-режим)";
                                            font-family: Theme.display-font;
                                            font-size: 17px;
                                            font-weight: 700;
                                            color: Theme.on-surface;
                                        }
                                        Text {
                                            text: root.user-email != "" ? (root.user-email + " · " + root.server-url) : root.server-url;
                                            font-size: 12.5px;
                                            color: Theme.on-surface-variant;
                                        }
                                        if root.profile-stats-text != "": Text {
                                            text: root.profile-stats-text;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.primary;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: root.authenticated ? Theme.error-container : (auth-act-ta.pressed ? Theme.primary-pressed : (auth-act-ta.has-hover ? Theme.primary-hover : Theme.primary));
                                            opacity: (root.authenticated && auth-act-ta.pressed) ? 0.78 : ((root.authenticated && auth-act-ta.has-hover) ? 0.9 : 1.0);
                                            animate background { duration: 120ms; }
                                            animate opacity { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 8px;
                                                if root.authenticated: VerticalLayout { alignment: center; Icon { name: "logout"; icon-size: 15px; icon-color: Theme.error; } }
                                                Text {
                                                    text: root.authenticated ? "Выйти" : "Войти";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.authenticated ? Theme.error : Theme.on-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            auth-act-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if root.authenticated {
                                                        root.logout();
                                                    } else {
                                                        root.demo-mode = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Platform style selector
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                VerticalLayout {
                                    alignment: start;
                                    padding: 20px;
                                    spacing: 12px;
                                    Text {
                                        text: "Адаптация под окружение (DE / Windows)";
                                        font-family: Theme.display-font;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }
                                    Text {
                                        text: "Меняет скругления, контуры и верхнюю панель под GNOME, KDE Plasma или Windows";
                                        font-size: 12.5px;
                                        color: Theme.on-surface-variant;
                                    }
                                    Rectangle {
                                        height: 44px;
                                        border-radius: Theme.pill-radius;
                                        background: Theme.surface-low;
                                        HorizontalLayout {
                                            padding: 4px;
                                            spacing: 4px;
                                            for p in [
                                                { id: "auto", label: "Авто" },
                                                { id: "gnome", label: "GNOME (M3)" },
                                                { id: "kde", label: "KDE (Breeze)" },
                                                { id: "windows", label: "Windows 11" },
                                            ]: Rectangle {
                                                property <bool> is-sel: root.platform-setting == p.id;
                                                horizontal-stretch: 1;
                                                border-radius: max(4px, Theme.pill-radius - 2px);
                                                background: is-sel ? Theme.primary-container : (plat-ta.pressed ? Theme.surface-highest : (plat-ta.has-hover ? Theme.surface-high : transparent));
                                                animate background { duration: 120ms; }
                                                Text {
                                                    text: p.label;
                                                    font-size: 12.5px;
                                                    font-weight: is-sel ? 700 : 500;
                                                    color: is-sel ? Theme.on-primary-container : Theme.on-surface;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                plat-ta := TouchArea { mouse-cursor: pointer; clicked => { root.set-platform(p.id); } }
                                            }
                                        }
                                    }
                                }
                            }

                            // Theme mode & accents
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                VerticalLayout {
                                    alignment: start;
                                    padding: 20px;
                                    spacing: 16px;

                                    Text {
                                        text: "Тема и акцент Material You";
                                        font-family: Theme.display-font;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }

                                    Rectangle {
                                        height: 44px;
                                        border-radius: Theme.pill-radius;
                                        background: Theme.surface-low;
                                        HorizontalLayout {
                                            padding: 4px;
                                            spacing: 4px;
                                            for tm in [
                                                { id: "system", label: "Системная" },
                                                { id: "dark", label: "Тёмная" },
                                                { id: "light", label: "Светлая" },
                                                { id: "amoled", label: "AMOLED" },
                                            ]: Rectangle {
                                                property <bool> is-sel: root.theme-mode == tm.id;
                                                horizontal-stretch: 1;
                                                border-radius: max(4px, Theme.pill-radius - 2px);
                                                background: is-sel ? Theme.primary-container : (tm-ta.pressed ? Theme.surface-highest : (tm-ta.has-hover ? Theme.surface-high : transparent));
                                                animate background { duration: 120ms; }
                                                Text {
                                                    text: tm.label;
                                                    font-size: 13px;
                                                    font-weight: is-sel ? 700 : 500;
                                                    color: is-sel ? Theme.on-primary-container : Theme.on-surface;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                tm-ta := TouchArea { mouse-cursor: pointer; clicked => { root.set-theme-mode(tm.id); } }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: "Следовать системному акценту (XDG Portal)";
                                            font-size: 13.5px;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 48px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: root.follow-system-accent ? (fsa-ta.has-hover ? Theme.primary-hover : Theme.primary) : (fsa-ta.has-hover ? Theme.surface-high : Theme.surface-highest);
                                            animate background { duration: 150ms; }
                                            Rectangle {
                                                x: root.follow-system-accent ? 25px : 3px;
                                                y: 3px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: root.follow-system-accent ? Theme.on-primary : Theme.on-surface-variant;
                                                animate x { duration: 150ms; }
                                            }
                                            fsa-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.follow-system-accent = !root.follow-system-accent;
                                                    root.set-follow-system-accent(root.follow-system-accent);
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        for sw in root.accent-swatches: Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: Theme.is-gnome ? 18px : 8px;
                                            background: sw.swatch;
                                            border-width: sw.active ? 2.5px : (sw-ta.has-hover ? 2px : 1px);
                                            border-color: (sw.active || sw-ta.has-hover) ? Theme.on-surface : Theme.outline-variant;
                                            if sw.active: Rectangle {
                                                x: 9px;
                                                y: 9px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: Theme.overlay-scrim;
                                                Icon {
                                                    x: 3px;
                                                    y: 3px;
                                                    name: "check";
                                                    icon-size: 12px;
                                                    icon-color: Theme.overlay-fg;
                                                }
                                            }
                                            sw-ta := TouchArea { mouse-cursor: pointer; clicked => { root.select-accent(sw.id); } }
                                        }
                                    }
                                }
                            }

                            // Window, Tray & Widget Settings
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                VerticalLayout {
                                    alignment: start;
                                    padding: 20px;
                                    spacing: 12px;

                                    Text {
                                        text: "Окно, трей и мини-виджет";
                                        font-family: Theme.display-font;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: "Сворачивать в системный трей при закрытии окна";
                                            font-size: 13.5px;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 48px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: root.close-to-tray ? (ctt-ta.has-hover ? Theme.primary-hover : Theme.primary) : (ctt-ta.has-hover ? Theme.surface-high : Theme.surface-highest);
                                            animate background { duration: 150ms; }
                                            Rectangle {
                                                x: root.close-to-tray ? 25px : 3px;
                                                y: 3px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: root.close-to-tray ? Theme.on-primary : Theme.on-surface-variant;
                                                animate x { duration: 150ms; }
                                            }
                                            ctt-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.close-to-tray = !root.close-to-tray;
                                                    root.set-close-to-tray(root.close-to-tray);
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: wid-btn-ta.pressed ? Theme.surface-highest : (wid-btn-ta.has-hover ? Theme.surface-high : Theme.primary-container);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 8px;
                                                VerticalLayout { alignment: center; Icon { name: "widget"; icon-size: 16px; icon-color: Theme.on-primary-container; } }
                                                Text { text: "Открыть мини-виджет"; font-size: 12.5px; font-weight: 600; color: Theme.on-primary-container; vertical-alignment: center; }
                                            }
                                            wid-btn-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-widget(); } }
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: tr-btn-ta.pressed ? Theme.surface-highest : (tr-btn-ta.has-hover ? Theme.surface-high : Theme.surface-low);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 8px;
                                                VerticalLayout { alignment: center; Icon { name: "tray"; icon-size: 16px; icon-color: Theme.on-surface; } }
                                                Text { text: "Свернуть в трей"; font-size: 12.5px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; }
                                            }
                                            tr-btn-ta := TouchArea { mouse-cursor: pointer; clicked => { root.hide-to-tray(); } }
                                        }
                                    }
                                }
                            }

                            // AI Prompt Mixes Config
                            Rectangle {
                                border-radius: Theme.card-radius;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                VerticalLayout {
                                    alignment: start;
                                    padding: 20px;
                                    spacing: 12px;

                                    Text {
                                        text: "ИИ-подборки (OpenAI-совместимый API, опционально)";
                                        font-family: Theme.display-font;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 36px;
                                            border-radius: Theme.row-radius;
                                            background: Theme.surface-high;
                                            border-width: 1px;
                                            border-color: llm-ep-inp.has-focus ? Theme.primary : Theme.outline-variant;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Rectangle {
                                                    if root.llm-endpoint-input == "" && !llm-ep-inp.has-focus: Text { width: 100%; height: 100%; text: "Endpoint (https://...)"; font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; }
                                                    llm-ep-inp := TextInput { width: 100%; height: 100%; text <=> root.llm-endpoint-input; font-size: 12px; color: Theme.on-surface; vertical-alignment: center; single-line: true; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 36px;
                                            border-radius: Theme.row-radius;
                                            background: Theme.surface-high;
                                            border-width: 1px;
                                            border-color: llm-mod-inp.has-focus ? Theme.primary : Theme.outline-variant;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Rectangle {
                                                    if root.llm-model-input == "" && !llm-mod-inp.has-focus: Text { width: 100%; height: 100%; text: "Модель"; font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; }
                                                    llm-mod-inp := TextInput { width: 100%; height: 100%; text <=> root.llm-model-input; font-size: 12px; color: Theme.on-surface; vertical-alignment: center; single-line: true; }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 36px;
                                            border-radius: Theme.row-radius;
                                            background: Theme.surface-high;
                                            border-width: 1px;
                                            border-color: llm-key-inp.has-focus ? Theme.primary : Theme.outline-variant;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Rectangle {
                                                    if root.llm-key-input == "" && !llm-key-inp.has-focus: Text { width: 100%; height: 100%; text: "API Key"; font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; }
                                                    llm-key-inp := TextInput { width: 100%; height: 100%; text <=> root.llm-key-input; input-type: InputType.password; font-size: 12px; color: Theme.on-surface; vertical-alignment: center; single-line: true; }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.pill-radius;
                                            background: ai-save-ta.pressed ? Theme.primary-pressed : (ai-save-ta.has-hover ? Theme.primary-hover : Theme.primary);
                                            animate background { duration: 120ms; }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                Text { text: "Сохранить"; font-size: 12.5px; font-weight: 600; color: Theme.on-primary; vertical-alignment: center; }
                                            }
                                            ai-save-ta := TouchArea { mouse-cursor: pointer; clicked => { root.save-ai-settings(root.llm-endpoint-input, root.llm-model-input, root.llm-key-input); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.queue-open && Theme.panel-border-width > 0px: Rectangle {
                width: Theme.panel-border-width;
                background: Theme.outline-variant;
            }

            // 3. RIGHT QUEUE & LYRICS PANEL
            Rectangle {
                visible: root.queue-open;
                width: root.queue-open ? 296px : 0px;
                clip: true;
                background: Theme.surface-low;

                VerticalLayout {
                    padding: root.queue-open ? 16px : 0px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.pill-radius;
                            background: Theme.surface-container;
                            HorizontalLayout {
                                padding: 4px;
                                spacing: 4px;
                                Rectangle {
                                    height: 28px;
                                    border-radius: max(4px, Theme.pill-radius - 2px);
                                    background: root.right-tab == "queue" ? Theme.primary-container : (qt-ta.pressed ? Theme.surface-highest : (qt-ta.has-hover ? Theme.surface-high : transparent));
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: "Очередь";
                                            font-family: Theme.display-font;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: root.right-tab == "queue" ? Theme.on-primary-container : Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    qt-ta := TouchArea { mouse-cursor: pointer; clicked => { root.right-tab = "queue"; } }
                                }
                                Rectangle {
                                    height: 28px;
                                    border-radius: max(4px, Theme.pill-radius - 2px);
                                    background: root.right-tab == "lyrics" ? Theme.primary-container : (lt-ta.pressed ? Theme.surface-highest : (lt-ta.has-hover ? Theme.surface-high : transparent));
                                    animate background { duration: 120ms; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: "Текст";
                                            font-family: Theme.display-font;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: root.right-tab == "lyrics" ? Theme.on-primary-container : Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }
                                    lt-ta := TouchArea { mouse-cursor: pointer; clicked => { root.right-tab = "lyrics"; } }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            TransportIconButton {
                                icon-name: "close";
                                icon-size: 16px;
                                btn-size: 30px;
                                clicked => { root.queue-open = false; }
                            }
                        }
                    }

                    // Queue ScrollView
                    queue-scroll := ScrollView {
                        visible: root.right-tab == "queue";
                        vertical-stretch: root.right-tab == "queue" ? 1 : 0;
                        max-height: root.right-tab == "queue" ? 10000px : 0px;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, queue-box.preferred-height);

                        queue-box := VerticalLayout {
                            width: parent.visible-width;
                            alignment: start;
                            spacing: 4px;
                            if root.queue-items.length == 0: VerticalLayout {
                                padding-top: 24px;
                                spacing: 8px;
                                HorizontalLayout { alignment: center; Icon { name: "queue-music"; icon-size: 24px; icon-color: Theme.on-surface-variant; } }
                                Text {
                                    text: "Очередь пуста";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: center;
                                }
                            }
                            for q[idx] in root.queue-items: QueueRow {
                                item: q;
                                clicked => { root.jump-queue(idx); }
                                remove-clicked => { root.remove-queue-item(idx); }
                            }
                        }
                    }

                    // Lyrics ScrollView
                    if root.right-tab == "lyrics": lyrics-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, lyrics-box.preferred-height);

                        lyrics-box := VerticalLayout {
                            width: parent.visible-width;
                            alignment: start;
                            spacing: 6px;
                            if root.lyric-lines.length == 0: Text {
                                text: "Текст песни пока недоступен";
                                font-size: 13px;
                                color: Theme.on-surface-variant;
                                wrap: word-wrap;
                            }
                            for ln in root.lyric-lines: Rectangle {
                                border-radius: Theme.row-radius;
                                background: ln.active ? Theme.primary-container : transparent;
                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: ln.text;
                                        font-family: Theme.display-font;
                                        font-size: ln.active ? 15px : 13.5px;
                                        font-weight: ln.active ? 700 : 500;
                                        color: ln.active ? Theme.on-primary-container : Theme.on-surface-variant;
                                        wrap: word-wrap;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: ln.start-ms >= 0 ? pointer : default;
                                    clicked => {
                                        if ln.start-ms >= 0 {
                                            root.seek-lyric(ln.start-ms);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Clear queue button
                    if root.right-tab == "queue": Rectangle {
                        height: 36px;
                        border-radius: Theme.pill-radius;
                        background: clr-ta.pressed ? Theme.surface-highest : (clr-ta.has-hover ? Theme.surface-high : Theme.surface-container);
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout { alignment: center; Icon { name: "trash"; icon-size: 16px; icon-color: Theme.on-surface-variant; } }
                            Text { text: "Очистить очередь"; font-size: 12.5px; font-weight: 500; color: Theme.on-surface-variant; vertical-alignment: center; }
                        }
                        clr-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear-queue(); } }
                    }
                }
            }
        }

        // ==================== PERSISTENT BOTTOM PLAYER BAR ====================
        Rectangle {
            height: 82px;
            background: Theme.surface-container;

            Rectangle {
                x: 0px;
                y: 4px;
                width: 100%;
                height: 3px;
                background: Theme.on-surface.with-alpha(0.16);

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * clamp(root.progress, 0.0, 1.0);
                    height: 3px;
                    background: Theme.primary;
                }
            }
            Rectangle {
                x: clamp(parent.width * clamp(root.progress, 0.0, 1.0) - 5px, 0px, parent.width - 10px);
                y: 0.5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.primary;
            }
            TouchArea {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 12px;
                mouse-cursor: pointer;
                clicked => {
                    if self.width > 0px {
                        root.seek-to(clamp(self.mouse-x / self.width, 0.0, 1.0));
                    }
                }
            }

            HorizontalLayout {
                y: 8px;
                height: 74px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                // Left: cover + metadata + heart
                HorizontalLayout {
                    width: 290px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 10px;
                            background: Theme.surface-high;
                            clip: true;
                            Image { width: 100%; height: 100%; source: root.now-cover; image-fit: cover; }
                            TouchArea {
                                mouse-cursor: root.has-current-track ? pointer : default;
                                clicked => { if root.has-current-track { root.player-open = true; } }
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.now-title != "" ? root.now-title : "Ничего не играет";
                            font-family: Theme.text-font;
                            font-size: 13.5px;
                            font-weight: 600;
                            color: Theme.on-surface;
                            overflow: elide;
                        }
                        Text {
                            text: root.now-artist != "" ? root.now-artist : "Выберите трек или включите волну";
                            font-family: Theme.text-font;
                            font-size: 12px;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                        }
                        TouchArea {
                            mouse-cursor: root.has-current-track ? pointer : default;
                            clicked => { if root.has-current-track { root.player-open = true; } }
                        }
                    }

                    if root.has-current-track: VerticalLayout {
                        alignment: center;
                        TransportIconButton {
                            icon-name: root.now-liked ? "heart-fill" : "heart";
                            active: root.now-liked;
                            icon-size: 19px;
                            clicked => { root.toggle-like-current(); }
                        }
                    }
                }

                // Center: Transport
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "shuffle"; active: root.shuffle; icon-size: 18px; clicked => { root.toggle-shuffle(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "prev"; icon-size: 22px; clicked => { root.prev-track(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: Theme.is-gnome ? 22px : 10px;
                            background: play-btn-ta.pressed ? Theme.primary-pressed : (play-btn-ta.has-hover ? Theme.primary-hover : Theme.primary);
                            animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            Icon {
                                x: root.playing ? 12px : 13px;
                                y: 12px;
                                name: root.playing ? "pause" : "play";
                                icon-size: 20px;
                                icon-color: Theme.on-primary;
                            }
                            play-btn-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-play(); } }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "next"; icon-size: 22px; clicked => { root.next-track(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton {
                            icon-name: root.repeat-mode == 2 ? "repeat-one" : "repeat";
                            active: root.repeat-mode > 0;
                            icon-size: 19px;
                            clicked => { root.cycle-repeat(); }
                        }
                    }
                }

                // Right: Queue toggle + Volume + Expand + More
                HorizontalLayout {
                    width: 280px;
                    alignment: end;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "queue-music"; active: root.queue-open; icon-size: 19px; clicked => { root.queue-open = !root.queue-open; } }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton {
                            icon-name: (root.muted || root.volume <= 0.01) ? "mute" : "volume";
                            icon-size: 19px;
                            clicked => { root.toggle-mute(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 94px;
                            height: 20px;
                            background: transparent;
                            Rectangle {
                                x: 0px;
                                y: 8px;
                                width: 100%;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.on-surface.with-alpha(0.16);
                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * (root.muted ? 0.0 : clamp(root.volume, 0.0, 1.0));
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.primary;
                                }
                            }
                            Rectangle {
                                x: clamp((parent.width - 12px) * (root.muted ? 0.0 : clamp(root.volume, 0.0, 1.0)), 0px, parent.width - 12px);
                                y: 4px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Theme.primary;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if self.width > 0px { root.set-volume(clamp(self.mouse-x / self.width, 0.0, 1.0)); } }
                                moved => { if self.pressed && self.width > 0px { root.set-volume(clamp(self.mouse-x / self.width, 0.0, 1.0)); } }
                            }
                        }
                    }
                    if root.has-current-track: VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "more"; icon-size: 18px; clicked => { root.open-track-menu("player", 0); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "widget"; icon-size: 18px; clicked => { root.open-widget(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        TransportIconButton { icon-name: "expand"; icon-size: 18px; clicked => { root.player-open = true; } }
                    }
                }
            }
        }
    }

    // ==================== IMMERSIVE NOW PLAYING OVERLAY ====================
    if root.show-app && root.player-open: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.surface;

        Image { width: 100%; height: 100%; source: root.player-backdrop; image-fit: cover; }
        TouchArea {}

        VerticalLayout {
            padding-left: 36px;
            padding-right: 36px;
            padding-top: 20px;
            padding-bottom: 24px;
            spacing: 16px;

            HorizontalLayout {
                width: 100%;
                alignment: space-between;
                TransportIconButton { icon-name: "collapse"; icon-size: 22px; btn-size: 38px; on-dark-overlay: true; clicked => { root.player-open = false; } }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "СЕЙЧАС ИГРАЕТ";
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: Theme.overlay-fg-muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.now-artist;
                        font-family: Theme.display-font;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.overlay-fg;
                        horizontal-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    TransportIconButton {
                        icon-name: "widget";
                        icon-size: 19px;
                        btn-size: 38px;
                        on-dark-overlay: true;
                        clicked => {
                            root.open-widget();
                        }
                    }
                    TransportIconButton {
                        icon-name: "queue-music";
                        icon-size: 20px;
                        btn-size: 38px;
                        on-dark-overlay: true;
                        clicked => {
                            root.player-open = false;
                            root.queue-open = true;
                            root.right-tab = "queue";
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 48px;
                padding-left: 32px;
                padding-right: 32px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: clamp(root.height * 0.42, 220px, 360px);
                        height: self.width;
                        border-radius: Theme.is-gnome ? 20px : 12px;
                        background: Theme.widget-placeholder;
                        border-width: 1px;
                        border-color: Theme.overlay-border;
                        clip: true;
                        Image { width: 100%; height: 100%; source: root.now-cover-hd; image-fit: cover; }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 12px;

                    Text { text: root.now-title; font-family: Theme.display-font; font-size: 32px; font-weight: 700; color: Theme.overlay-fg; overflow: elide; }
                    Text { text: root.now-artist; font-size: 17px; color: Theme.overlay-fg-muted; overflow: elide; }

                    Rectangle { height: 4px; }

                    player-lyrics-scroll := ScrollView {
                        height: clamp(root.height * 0.34, 180px, 280px);
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, p-lyrics-box.preferred-height);

                        p-lyrics-box := VerticalLayout {
                            width: parent.visible-width;
                            alignment: start;
                            spacing: 6px;
                            if root.lyric-lines.length == 0: Text {
                                text: "Синхронизированный текст появится здесь, когда на сервере есть лирика для трека";
                                font-size: 16px;
                                color: Theme.overlay-fg-muted;
                                wrap: word-wrap;
                            }
                            for ln in root.lyric-lines: Rectangle {
                                border-radius: 10px;
                                background: ln.active ? Theme.overlay-surface : transparent;
                                HorizontalLayout {
                                    padding-left: ln.active ? 12px : 0px;
                                    padding-right: 12px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    Text {
                                        text: ln.text;
                                        font-family: Theme.display-font;
                                        font-size: ln.active ? 22px : 17.5px;
                                        font-weight: ln.active ? 700 : 500;
                                        color: ln.active ? Theme.overlay-fg : Theme.overlay-fg-muted;
                                        opacity: ln.active ? 1.0 : 0.78;
                                        wrap: word-wrap;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: ln.start-ms >= 0 ? pointer : default;
                                    clicked => { if ln.start-ms >= 0 { root.seek-lyric(ln.start-ms); } }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.pill-radius;
                            background: pl-like-ta.pressed ? Theme.overlay-surface-pressed : (root.now-liked ? Theme.overlay-accent.with-alpha(0.24) : (pl-like-ta.has-hover ? Theme.overlay-surface-hover : Theme.overlay-surface));
                            border-width: root.now-liked ? 1px : 0px;
                            border-color: Theme.overlay-accent.with-alpha(0.55);
                            animate background { duration: 120ms; }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                VerticalLayout { alignment: center; Icon { name: root.now-liked ? "heart-fill" : "heart"; icon-size: 16px; icon-color: root.now-liked ? Theme.overlay-accent : Theme.overlay-fg; } }
                                Text { text: root.now-liked ? "В избранном" : "В избранное"; font-size: 13px; font-weight: 600; color: Theme.overlay-fg; vertical-alignment: center; }
                            }
                            pl-like-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-like-current(); } }
                        }
                        if root.has-current-track: Rectangle {
                            height: 36px;
                            border-radius: Theme.pill-radius;
                            background: pl-more-ta.pressed ? Theme.overlay-surface-pressed : (pl-more-ta.has-hover ? Theme.overlay-surface-hover : Theme.overlay-surface);
                            animate background { duration: 120ms; }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                VerticalLayout { alignment: center; Icon { name: "more"; icon-size: 16px; icon-color: Theme.overlay-fg; } }
                                Text { text: "Действия"; font-size: 13px; font-weight: 600; color: Theme.overlay-fg; vertical-alignment: center; }
                            }
                            pl-more-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-track-menu("player", 0); } }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 12px;
                Rectangle {
                    width: 100%;
                    height: 16px;
                    Rectangle {
                        x: 0px;
                        y: 6px;
                        width: 100%;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.overlay-track;
                        Rectangle { x: 0px; width: parent.width * clamp(root.progress, 0.0, 1.0); height: 4px; border-radius: 2px; background: Theme.overlay-accent; }
                    }
                    Rectangle {
                        x: clamp((parent.width - 14px) * clamp(root.progress, 0.0, 1.0), 0px, parent.width - 14px);
                        y: 1px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.overlay-fg;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if self.width > 0px { root.seek-to(clamp(self.mouse-x / self.width, 0.0, 1.0)); } }
                    }
                }
                HorizontalLayout {
                    width: 100%;
                    alignment: space-between;
                    Text { text: root.now-pos-text; font-size: 12px; color: Theme.overlay-fg-muted; }
                    Text { text: root.now-dur-text; font-size: 12px; color: Theme.overlay-fg-muted; }
                }
                HorizontalLayout {
                    width: 100%;
                    alignment: center;
                    spacing: 24px;
                    VerticalLayout { alignment: center; TransportIconButton { icon-name: "shuffle"; active: root.shuffle; on-dark-overlay: true; icon-size: 22px; btn-size: 44px; clicked => { root.toggle-shuffle(); } } }
                    VerticalLayout { alignment: center; TransportIconButton { icon-name: "prev"; on-dark-overlay: true; icon-size: 28px; btn-size: 48px; clicked => { root.prev-track(); } } }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: p-fab-ta.pressed ? Theme.overlay-fg-muted : (p-fab-ta.has-hover ? Theme.overlay-fg : Theme.overlay-accent);
                            animate background { duration: 120ms; }
                            Icon { x: root.playing ? 18px : 20px; y: 18px; name: root.playing ? "pause" : "play"; icon-size: 28px; icon-color: Theme.overlay-on-accent; }
                            p-fab-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-play(); } }
                        }
                    }
                    VerticalLayout { alignment: center; TransportIconButton { icon-name: "next"; on-dark-overlay: true; icon-size: 28px; btn-size: 48px; clicked => { root.next-track(); } } }
                    VerticalLayout { alignment: center; TransportIconButton { icon-name: root.repeat-mode == 2 ? "repeat-one" : "repeat"; active: root.repeat-mode > 0; on-dark-overlay: true; icon-size: 22px; btn-size: 44px; clicked => { root.cycle-repeat(); } } }
                }
            }
        }
    }

    // ==================== TRACK ACTIONS MENU MODAL ====================
    if root.show-app && root.track-menu.visible: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.modal-backdrop;

        TouchArea { clicked => { root.close-track-menu(); } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: min(560px, parent.height - 64px);
            border-radius: Theme.hero-radius;
            background: Theme.surface-container;
            border-width: 1px;
            border-color: Theme.outline-variant;

            TouchArea {}

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 48px; height: 48px; border-radius: 10px; clip: true;
                        Image { width: 100%; height: 100%; source: root.track-menu.cover; image-fit: cover; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: root.track-menu.title; font-size: 15px; font-weight: 700; color: Theme.on-surface; overflow: elide; }
                        Text { text: root.track-menu.artist; font-size: 12.5px; color: Theme.on-surface-variant; overflow: elide; }
                    }
                    TransportIconButton { icon-name: "close"; icon-size: 18px; btn-size: 30px; clicked => { root.close-track-menu(); } }
                }

                Rectangle { height: 1px; background: Theme.outline-variant; opacity: 0.4; }

                menu-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, menu-box.preferred-height);

                    menu-box := VerticalLayout {
                        width: parent.visible-width;
                        alignment: start;
                        spacing: 2px;

                        if !root.track-menu.playlist-picker-open: VerticalLayout {
                            spacing: 2px;
                            NavButton { icon-name: "playlist-play"; label: "Включить следующим"; clicked => { root.track-menu-play-next(); } }
                            NavButton { icon-name: "queue-add"; label: "Добавить в очередь"; clicked => { root.track-menu-add-queue(); } }
                            NavButton { icon-name: root.track-menu.liked ? "heart-fill" : "heart"; label: root.track-menu.liked ? "Убрать из избранного" : "В избранное"; clicked => { root.track-menu-toggle-like(); } }
                            NavButton { icon-name: "dislike"; label: root.track-menu.disliked ? "Убрать дизлайк" : "Не нравится (скрыть)"; clicked => { root.track-menu-toggle-dislike(); } }
                            NavButton { icon-name: "playlist-add"; label: "Добавить в плейлист"; clicked => { root.track-menu.playlist-picker-open = true; } }
                            if root.track-menu.in-editable-playlist: NavButton { icon-name: "trash"; label: "Убрать из плейлиста"; clicked => { root.track-menu-remove-from-playlist(); } }
                            NavButton { icon-name: "download"; label: root.track-menu.downloaded ? "Удалить с устройства" : "Скачать офлайн"; clicked => { root.track-menu-toggle-download(); } }
                            if root.track-menu.artist-id != "": NavButton { icon-name: "artist"; label: "Перейти к артисту"; clicked => { root.track-menu-open-artist(); } }
                            if root.track-menu.album-id != "": NavButton { icon-name: "library"; label: "Перейти к альбому"; clicked => { root.track-menu-open-album(); } }
                            NavButton { icon-name: "share"; label: "Поделиться ссылкой"; clicked => { root.track-menu-share(); } }
                            NavButton { icon-name: "info"; label: "Информация о качестве"; clicked => { root.track-menu-load-info(); } }
                            NavButton { icon-name: "flag"; label: "Сообщить о цензуре"; clicked => { root.track-menu-report-censorship(); } }
                        }

                        if root.track-menu.playlist-picker-open: VerticalLayout {
                            spacing: 4px;
                            NavButton { icon-name: "back"; label: "Назад к действиям"; clicked => { root.track-menu.playlist-picker-open = false; } }
                            for pl in root.sidebar-playlists: NavButton {
                                icon-name: "playlist-add";
                                label: pl.title + " (" + pl.count-text + ")";
                                clicked => { root.track-menu-add-to-playlist(pl.id); }
                            }
                            NavButton { icon-name: "plus"; label: "Создать новый плейлист"; clicked => { root.close-track-menu(); root.open-create-playlist(); } }
                        }

                        if root.track-menu.details-text != "": Rectangle {
                            border-radius: Theme.row-radius;
                            background: Theme.surface-low;
                            HorizontalLayout {
                                padding: 10px;
                                Text { text: root.track-menu.details-text; font-size: 12px; color: Theme.on-surface-variant; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== PLAYLIST CREATE / RENAME MODAL ====================
    if root.show-app && root.playlist-modal-open: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.modal-backdrop;

        TouchArea { clicked => { root.playlist-modal-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: 290px;
            border-radius: Theme.hero-radius;
            background: Theme.surface-container;
            border-width: 1px;
            border-color: Theme.outline-variant;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: root.playlist-modal-edit ? "Переименовать плейлист" : "Новый плейлист";
                        font-family: Theme.display-font;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TransportIconButton { icon-name: "close"; icon-size: 18px; btn-size: 30px; clicked => { root.playlist-modal-open = false; } }
                }

                Rectangle {
                    height: 40px;
                    border-radius: Theme.row-radius;
                    background: Theme.surface-high;
                    border-width: 1px;
                    border-color: pl-t-inp.has-focus ? Theme.primary : Theme.outline-variant;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Rectangle {
                            if root.playlist-modal-title == "" && !pl-t-inp.has-focus: Text { width: 100%; height: 100%; text: "Название плейлиста"; font-size: 13px; color: Theme.on-surface-variant; vertical-alignment: center; }
                            pl-t-inp := TextInput { width: 100%; height: 100%; text <=> root.playlist-modal-title; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; single-line: true; }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    border-radius: Theme.row-radius;
                    background: Theme.surface-high;
                    border-width: 1px;
                    border-color: pl-d-inp.has-focus ? Theme.primary : Theme.outline-variant;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Rectangle {
                            if root.playlist-modal-desc == "" && !pl-d-inp.has-focus: Text { width: 100%; height: 100%; text: "Описание (необязательно)"; font-size: 13px; color: Theme.on-surface-variant; vertical-alignment: center; }
                            pl-d-inp := TextInput { width: 100%; height: 100%; text <=> root.playlist-modal-desc; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; single-line: true; }
                        }
                    }
                }

                if !root.playlist-modal-edit: HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Публичный плейлист"; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: 44px; height: 24px; border-radius: 12px;
                        background: root.playlist-modal-public ? (pl-pub-ta.has-hover ? Theme.primary-hover : Theme.primary) : (pl-pub-ta.has-hover ? Theme.surface-high : Theme.surface-highest);
                        animate background { duration: 150ms; }
                        Rectangle {
                            x: root.playlist-modal-public ? 22px : 2px;
                            y: 2px; width: 20px; height: 20px; border-radius: 10px;
                            background: root.playlist-modal-public ? Theme.on-primary : Theme.on-surface-variant;
                            animate x { duration: 150ms; }
                        }
                        pl-pub-ta := TouchArea { mouse-cursor: pointer; clicked => { root.playlist-modal-public = !root.playlist-modal-public; } }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    Rectangle {
                        height: 36px;
                        border-radius: Theme.pill-radius;
                        background: pl-sub-ta.pressed ? Theme.primary-pressed : (pl-sub-ta.has-hover ? Theme.primary-hover : Theme.primary);
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Text {
                                text: root.playlist-modal-edit ? "Сохранить" : "Создать";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.on-primary;
                                vertical-alignment: center;
                            }
                        }
                        pl-sub-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.submit-playlist-modal(root.playlist-modal-title, root.playlist-modal-desc, root.playlist-modal-public);
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== TOAST / SNACKBAR ====================
    if root.toast-message != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 130px;
        height: 40px;
        border-radius: Theme.pill-radius;
        background: Theme.surface-highest;
        border-width: 1px;
        border-color: Theme.outline-variant;

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            Text {
                text: root.toast-message;
                font-size: 13px;
                font-weight: 500;
                color: Theme.on-surface;
                vertical-alignment: center;
            }
        }
    }
}
